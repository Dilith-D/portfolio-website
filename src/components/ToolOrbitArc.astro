---
const OPENAI_PATH = 'M22.282 9.821a5.985 5.985 0 0 0-.516-4.91 6.046 6.046 0 0 0-6.51-2.9A6.065 6.065 0 0 0 4.981 4.18a5.985 5.985 0 0 0-3.998 2.9 6.046 6.046 0 0 0 .743 7.097 5.98 5.98 0 0 0 .51 4.911 6.051 6.051 0 0 0 6.515 2.9A5.985 5.985 0 0 0 13.26 24a6.056 6.056 0 0 0 5.772-4.206 5.99 5.99 0 0 0 3.997-2.9 6.056 6.056 0 0 0-.747-7.073zM13.26 22.43a4.476 4.476 0 0 1-2.876-1.04l.141-.081 4.779-2.758a.795.795 0 0 0 .392-.681v-6.737l2.02 1.168a.071.071 0 0 1 .038.052v5.583a4.504 4.504 0 0 1-4.494 4.494zM3.6 18.304a4.47 4.47 0 0 1-.535-3.014l.142.085 4.783 2.759a.771.771 0 0 0 .78 0l5.843-3.369v2.332a.08.08 0 0 1-.033.062L9.74 19.95a4.5 4.5 0 0 1-6.14-1.646zM2.34 7.896a4.485 4.485 0 0 1 2.366-1.973V11.6a.766.766 0 0 0 .388.676l5.815 3.355-2.02 1.168a.076.076 0 0 1-.071 0l-4.83-2.786A4.504 4.504 0 0 1 2.34 7.872zm16.597 3.855l-5.843-3.369 2.02-1.168a.076.076 0 0 1 .071 0l4.83 2.791a4.494 4.494 0 0 1-.676 8.105v-5.678a.79.79 0 0 0-.402-.681zm2.01-3.023l-.141-.085-4.774-2.782a.776.776 0 0 0-.785 0L9.409 9.23V6.897a.066.066 0 0 1 .028-.061l4.83-2.786a4.5 4.5 0 0 1 6.68 4.66zm-12.64 4.135l-2.02-1.164a.08.08 0 0 1-.038-.057V6.075a4.5 4.5 0 0 1 7.375-3.453l-.142.08L8.704 5.46a.795.795 0 0 0-.393.681zm1.097-2.365l2.602-1.5 2.607 1.5v2.999l-2.597 1.5-2.607-1.5z';
const LOVABLE_PATH = 'M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z';

const TOOLS = [
  { type: 'img', src: 'https://cdn.simpleicons.org/claude',     name: 'Claude',      fallback: 'A',   category: 'Reasoning'  },
  { type: 'svg', svgPath: OPENAI_PATH, fill: '#000000',         name: 'GPT-4',                        category: 'Chat'       },
  { type: 'img', src: 'https://cdn.simpleicons.org/figma',      name: 'Figma',       fallback: 'Fg',  category: 'Design'     },
  { type: 'img', src: 'https://cdn.simpleicons.org/notion',     name: 'Notion',      fallback: 'N',   category: 'Writing'    },
  { type: 'img', src: 'https://cdn.simpleicons.org/linear',     name: 'Linear',      fallback: 'Li',  category: 'Planning'   },
  { type: 'img', src: 'https://cdn.simpleicons.org/supabase',   name: 'Supabase',    fallback: 'SB',  category: 'Backend'    },
  { type: 'img', src: 'https://cdn.simpleicons.org/n8n',        name: 'n8n',         fallback: 'n8n', category: 'Automation' },
  { type: 'img', src: 'https://cdn.simpleicons.org/elevenlabs', name: 'ElevenLabs',  fallback: 'EL',  category: 'Audio'      },
  { type: 'img', src: 'https://cdn.simpleicons.org/deepgram',   name: 'Deepgram',    fallback: 'DG',  category: 'Speech'     },
  { type: 'img', src: 'https://cdn.simpleicons.org/postman',    name: 'Postman',     fallback: 'PM',  category: 'APIs'       },
  { type: 'text', abbr: 'VAPI',                                 name: 'VAPI',                         category: 'Voice'      },
  { type: 'svg', svgPath: LOVABLE_PATH, fill: '#FF4D6D',        name: 'Lovable',                      category: 'Prototype'  },
];
const STEP = 360 / TOOLS.length;
---

<div class="orbit-system" aria-hidden="true">

  <!-- Sun — the fixed center element everything orbits -->
  <div class="orbit-sun">
    <div class="orbit-sun-bloom"></div>
    <div class="orbit-sun-nebula"></div>
    <div class="orbit-sun-core">
      <span class="orbit-sun-label" id="orbitSunLabel">AI PM</span>
    </div>
  </div>

  <!-- Decorative orbit ring -->
  <div class="orbit-ring"></div>

  <!-- Rotating pivot — centered, drives all planet chips -->
  <div class="orbit-pivot">
    {TOOLS.map((tool, i) => (
      <div
        class="orbit-item"
        style={`--orbit-angle: ${(i * STEP).toFixed(3)}; --pd: ${(4 + (i % 5) * 0.5).toFixed(1)}s; --pdel: ${(-(i * 0.7)).toFixed(1)}s;`}
        title={tool.name}
        data-category={tool.category}
      >
        <div class="orbit-spoke">
          <div class="orbit-particle"></div>
        </div>
        <div class="orbit-chip">
          {tool.type === 'img' ? (
            <>
              <img
                src={tool.src}
                alt={tool.name}
                class="orbit-logo"
                loading="lazy"
                decoding="async"
                width="40"
                height="40"
                onerror={`this.style.display='none';this.nextElementSibling.style.display='flex';`}
              />
              <span class="orbit-label orbit-fallback">{tool.fallback}</span>
            </>
          ) : tool.type === 'svg' ? (
            <svg viewBox="0 0 24 24" class="orbit-svg-icon" aria-hidden="true">
              <path d={tool.svgPath} fill={tool.fill ?? '#1a1a1a'} />
            </svg>
          ) : (
            <span class="orbit-label">{tool.abbr}</span>
          )}
        </div>
      </div>
    ))}
  </div>

</div>

<!-- Mobile: pill list -->
<ul class="orbit-mobile" aria-label="Tools I use">
  {TOOLS.map(t => <li class="orbit-pill">{t.name}</li>)}
</ul>

<script>
  const system = document.querySelector('.orbit-system');
  const sunLabel = document.getElementById('orbitSunLabel');
  if (system && sunLabel) {
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
    let swapTimer;

    const setLabel = (text) => {
      if (sunLabel.textContent === text) return;
      clearTimeout(swapTimer);
      const apply = () => {
        sunLabel.textContent = text;
        sunLabel.classList.toggle('is-category', text !== 'AI PM');
        sunLabel.style.opacity = '1';
      };
      if (reduced.matches) { apply(); return; }
      sunLabel.style.opacity = '0';
      swapTimer = setTimeout(apply, 120);
    };

    system.querySelectorAll('.orbit-item').forEach((item) => {
      item.addEventListener('mouseenter', () => setLabel(item.dataset.category || 'AI PM'));
      item.addEventListener('mouseleave', () => setLabel('AI PM'));
    });
  }
</script>

<style>
  /* ── System container — full circle, no clipping ─── */
  .orbit-system {
    --r:     230px;   /* orbit radius         */
    --chip:   72px;   /* planet chip diameter */
    --chip-h: 36px;   /* half chip            */
    --sun:    92px;   /* sun diameter         */
    /* single accent for glow, spokes, and particles */
    --orb-accent: var(--color-electric);
    /* glow intensities — overridden in dark mode so bloom doesn't wash out */
    --orb-nebula-a: 32%;
    --orb-bloom-a:  16%;
    --spoke-rest:   var(--color-border-card);
    --spoke-hot:    color-mix(in srgb, var(--orb-accent) 60%, transparent);

    position: relative;
    /* big enough to contain chips at all four sides */
    width:  calc(var(--r) * 2 + var(--chip) + 16px);
    height: calc(var(--r) * 2 + var(--chip) + 16px);
    margin: 0 auto;
    flex-shrink: 0;
  }

  /* ── Sun — fixed center, everything orbits it ─────── */
  .orbit-sun {
    position: absolute;
    top:  50%;
    left: 50%;
    translate: -50% -50%;
    z-index: 3;
    /* decorative outer glow rings */
    width:  calc(var(--sun) + 32px);
    height: calc(var(--sun) + 32px);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    /* concentric ring halo */
    box-shadow:
      0 0 0 1px var(--color-border),
      0 0 0 18px rgba(28, 24, 20, 0.04),
      0 0 0 19px var(--color-border);
  }

  /* Soft outer bloom — wide, heavily blurred accent glow */
  .orbit-sun-bloom {
    position: absolute;
    inset: 0;
    margin: auto;
    width:  140px;
    height: 140px;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      color-mix(in srgb, var(--orb-accent) var(--orb-bloom-a), transparent) 0%,
      transparent 70%
    );
    filter: blur(20px);
    pointer-events: none;
  }

  /* Nebula halo — tighter accent gradient peeking out around the core */
  .orbit-sun-nebula {
    position: absolute;
    inset: 0;
    margin: auto;
    width:  118px;
    height: 118px;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      color-mix(in srgb, var(--orb-accent) var(--orb-nebula-a), transparent) 0%,
      color-mix(in srgb, var(--orb-accent) calc(var(--orb-nebula-a) / 3), transparent) 45%,
      transparent 72%
    );
    pointer-events: none;
  }

  .orbit-sun-core {
    position: relative;
    width:  var(--sun);
    height: var(--sun);
    border-radius: 50%;
    background: var(--color-primary);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2px;
    box-shadow:
      0 8px 32px rgba(0, 0, 0, 0.22),
      0 2px 8px  rgba(0, 0, 0, 0.14);
  }

  /* Breathing — core, nebula, and bloom scale together */
  .orbit-sun-core,
  .orbit-sun-nebula,
  .orbit-sun-bloom {
    animation: orb-breathe 3.5s ease-in-out infinite;
  }

  @keyframes orb-breathe {
    0%, 100% { transform: scale(1); }
    50%      { transform: scale(1.04); }
  }

  .orbit-sun-label {
    font-family: 'Inter', sans-serif;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-background);
    line-height: 1;
    width: 100%;
    text-align: center;
    transition: opacity 120ms ease;
  }

  /* Category labels can be longer than "AI PM" — tighten so they fit the core */
  .orbit-sun-label.is-category {
    font-size: 10px;
    letter-spacing: 0.07em;
  }

  /* ── Decorative orbit ring ──────────────────────── */
  .orbit-ring {
    position: absolute;
    top:  50%;
    left: 50%;
    translate: -50% -50%;
    width:  calc(var(--r) * 2);
    height: calc(var(--r) * 2);
    border-radius: 50%;
    border: 1px dashed var(--color-border);
    pointer-events: none;
  }

  /* ── Rotating pivot — zero-size, at center ───────── */
  .orbit-pivot {
    position: absolute;
    top:  50%;
    left: 50%;
    width: 0;
    height: 0;
    animation: pivot-spin 40s linear infinite;
  }

  @keyframes pivot-spin {
    to { transform: rotate(360deg); }
  }

  /* Pause the orbit while a chip is hovered — keeps the icon under the cursor */
  .orbit-system:has(.orbit-item:hover) .orbit-pivot,
  .orbit-system:has(.orbit-item:hover) .orbit-chip {
    animation-play-state: paused;
  }

  /* ── Planet chips ────────────────────────────────── */
  .orbit-item {
    position: absolute;
    top:  calc(-1 * var(--chip-h));
    left: calc(-1 * var(--chip-h));
    width:  var(--chip);
    height: var(--chip);
    transform:
      rotate(calc(var(--orbit-angle) * 1deg))
      translateY(calc(-1 * var(--r)));
  }

  /* ── Connector spoke — chip center back toward the sun ──
     The item's local +y axis points at the orb center, so the
     spoke needs no rotation of its own and travels with the orbit. */
  .orbit-spoke {
    position: absolute;
    top:  50%;
    left: calc(50% - 0.5px);
    width: 0;
    height: calc(var(--r) - var(--sun) / 2 - 10px);
    border-left: 1px dotted var(--spoke-rest);
    z-index: 0;
    transition: border-color 200ms ease;
  }

  /* ── Traveling particle — orb → icon → orb, staggered per line ── */
  .orbit-particle {
    position: absolute;
    top: 0;
    left: -2.5px;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--orb-accent);
    box-shadow: 0 0 6px 1px color-mix(in srgb, var(--orb-accent) 55%, transparent);
    opacity: 0.7;
    animation: particle-travel var(--pd, 5s) ease-in-out infinite;
    animation-delay: var(--pdel, 0s);
    transition: opacity 200ms ease, box-shadow 200ms ease;
  }

  @keyframes particle-travel {
    0%, 100% { transform: translateY(calc(var(--r) - var(--sun) / 2 - 16px)); }
    50%      { transform: translateY(calc(var(--chip-h) + 4px)); }
  }

  /* ── Hover: line brightens, particle energizes ───── */
  .orbit-item:hover .orbit-spoke {
    border-left-color: var(--spoke-hot);
  }

  .orbit-item:hover .orbit-particle {
    animation-duration: 1.5s;
    opacity: 1;
    box-shadow: 0 0 10px 2px color-mix(in srgb, var(--orb-accent) 80%, transparent);
  }

  .orbit-chip {
    position: relative;
    z-index: 1;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    background: #ffffff;
    border: 1px solid rgba(0, 0, 0, 0.08);
    box-shadow:
      0 4px 16px rgba(0, 0, 0, 0.10),
      inset 0 1px 0 rgba(255,255,255,0.9);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    animation: chip-counter 40s linear infinite;
  }

  @keyframes chip-counter {
    from { transform: rotate(calc(var(--orbit-angle) * -1deg)); }
    to   { transform: rotate(calc(var(--orbit-angle) * -1deg - 360deg)); }
  }

  /* ── Logo image ──────────────────────────────────── */
  .orbit-logo {
    width:  58%;
    height: 58%;
    object-fit: contain;
    display: block;
    user-select: none;
    pointer-events: none;
  }

  /* ── Inline SVG icon (OpenAI, Lovable) ───────────── */
  .orbit-svg-icon {
    width:  58%;
    height: 58%;
    display: block;
    user-select: none;
    pointer-events: none;
    flex-shrink: 0;
  }

  .orbit-fallback { display: none; }

  /* ── Text label (VAPI, Lovable) ──────────────────── */
  .orbit-label {
    font-family: 'Inter', sans-serif;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: #1a1a1a;
    line-height: 1;
    user-select: none;
    pointer-events: none;
  }

  /* ── Dark mode ───────────────────────────────────── */
  :global(html.dark) .orbit-system {
    /* lighten electric blue and boost glow so it doesn't disappear
       against the near-black background */
    --orb-accent: color-mix(in srgb, var(--color-electric) 72%, white);
    --orb-nebula-a: 44%;
    --orb-bloom-a:  24%;
    --spoke-rest:   rgba(255, 255, 255, 0.14);
  }

  :global(html.dark) .orbit-sun {
    box-shadow:
      0 0 0 1px rgba(255,255,255,0.1),
      0 0 0 18px rgba(240, 237, 231, 0.04),
      0 0 0 19px rgba(255,255,255,0.08);
  }

  :global(html.dark) .orbit-chip {
    background: #ffffff;
    border-color: rgba(255,255,255,0.1);
    box-shadow:
      0 4px 20px rgba(0, 0, 0, 0.55),
      inset 0 1px 0 rgba(255,255,255,0.9);
  }

  /* ── Reduced motion — no motion at all ───────────── */
  @media (prefers-reduced-motion: reduce) {
    .orbit-pivot,
    .orbit-sun-core,
    .orbit-sun-nebula,
    .orbit-sun-bloom { animation: none; }
    .orbit-particle  { display: none; }
    .orbit-sun-label { transition: none; }
    .orbit-chip {
      animation: none;
      transform: rotate(calc(var(--orbit-angle) * -1deg));
    }
  }

  /* ── Mobile ──────────────────────────────────────── */
  .orbit-mobile {
    display: none;
    list-style: none;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 0;
    justify-content: center;
  }
  .orbit-pill {
    font-family: 'Inter', sans-serif;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-secondary);
    border: 1px solid var(--color-border);
    border-radius: 4px;
    padding: 5px 12px;
  }

  @media (max-width: 767px) {
    .orbit-system { display: none; }
    .orbit-mobile  { display: flex; }
  }
</style>
