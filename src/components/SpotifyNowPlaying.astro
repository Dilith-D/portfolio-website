---
// Fetches from /.netlify/functions/now-playing — client-side only.
// Hidden until data loads; fails silently if the function is unavailable.
---

<div id="spotify-widget" class="spotify-widget" style="display:none;" aria-label="Music currently playing">

  <div class="spotify-header">
    <span class="spotify-tag" id="spotify-label">LISTENING NOW</span>
    <!-- Animated equalizer — only visible when actively playing -->
    <span class="spotify-eq" id="spotify-eq" aria-hidden="true">
      <span class="spotify-bar bar1"></span>
      <span class="spotify-bar bar2"></span>
      <span class="spotify-bar bar3"></span>
    </span>
  </div>

  <a id="spotify-link" href="#" target="_blank" rel="noopener noreferrer" class="spotify-track">
    <img id="spotify-art" src="" alt="" class="spotify-art" width="40" height="40" />
    <div class="spotify-text">
      <span id="spotify-title" class="spotify-title"></span>
      <span id="spotify-artist" class="spotify-artist"></span>
    </div>
    <!-- Spotify logo -->
    <svg class="spotify-logo" viewBox="0 0 24 24" fill="currentColor" aria-label="Open in Spotify">
      <path d="M12 0C5.4 0 0 5.4 0 12s5.4 12 12 12 12-5.4 12-12S18.66 0 12 0zm5.521 17.34c-.24.359-.66.48-1.021.24-2.82-1.74-6.36-2.101-10.561-1.141-.418.122-.779-.179-.899-.539-.12-.421.18-.78.54-.9 4.56-1.021 8.52-.6 11.64 1.32.42.18.479.659.301 1.02zm1.44-3.3c-.301.42-.841.6-1.262.3-3.239-1.98-8.159-2.58-11.939-1.38-.479.12-1.02-.12-1.14-.6-.12-.48.12-1.021.6-1.141C9.6 9.9 15 10.561 18.72 12.84c.361.181.54.78.241 1.2zm.12-3.36C15.24 8.4 8.82 8.16 5.16 9.301c-.6.179-1.2-.181-1.38-.721-.18-.601.18-1.2.72-1.381 4.26-1.26 11.28-1.02 15.721 1.621.539.3.719 1.02.419 1.56-.299.421-1.02.599-1.559.3z"/>
    </svg>
  </a>

</div>

<style>
.spotify-widget {
  margin-top: 2rem;
}

.spotify-header {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 10px;
}

.spotify-tag {
  font-family: 'Inter', sans-serif;
  font-size: 0.6875rem;
  font-weight: 500;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: var(--color-secondary);
}

/* Equalizer bars */
.spotify-eq {
  display: flex;
  align-items: flex-end;
  gap: 2px;
  height: 12px;
}

.spotify-bar {
  display: block;
  width: 3px;
  border-radius: 2px;
  background: var(--color-secondary);
  transform-origin: bottom;
}

.bar1 { animation: eq 0.9s ease-in-out 0.0s infinite alternate; height: 12px; }
.bar2 { animation: eq 0.9s ease-in-out 0.2s infinite alternate; height: 12px; }
.bar3 { animation: eq 0.9s ease-in-out 0.4s infinite alternate; height: 12px; }

@keyframes eq {
  from { transform: scaleY(0.25); }
  to   { transform: scaleY(1.0);  }
}

@media (prefers-reduced-motion: reduce) {
  .spotify-bar { animation: none; transform: scaleY(0.6); }
}

/* Track row */
.spotify-track {
  display: flex;
  align-items: center;
  gap: 12px;
  text-decoration: none;
  max-width: 480px;
  padding: 6px 0;
  transition: opacity 150ms ease;
}

.spotify-track:hover { opacity: 0.72; }

.spotify-art {
  width: 40px;
  height: 40px;
  border-radius: 4px;
  object-fit: cover;
  flex-shrink: 0;
  background: var(--color-surface);
}

.spotify-text {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.spotify-title {
  font-family: 'Inter', sans-serif;
  font-size: 0.9375rem;
  font-weight: 500;
  color: var(--color-primary);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.spotify-artist {
  font-family: 'Inter', sans-serif;
  font-size: 0.8125rem;
  color: var(--color-secondary);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.spotify-logo {
  width: 18px;
  height: 18px;
  color: #1DB954;
  flex-shrink: 0;
  opacity: 0.8;
  transition: opacity 150ms ease;
}

.spotify-track:hover .spotify-logo { opacity: 1; }
</style>

<script>
(function () {
  const widget  = document.getElementById('spotify-widget');
  const label   = document.getElementById('spotify-label');
  const eq      = document.getElementById('spotify-eq');
  const link    = document.getElementById('spotify-link');
  const art     = document.getElementById('spotify-art');
  const titleEl = document.getElementById('spotify-title');
  const artistEl = document.getElementById('spotify-artist');

  if (!widget) return;

  async function fetchNowPlaying() {
    try {
      const res = await fetch('/.netlify/functions/now-playing');
      if (!res.ok) return;
      const data = await res.json();

      if (!data.title) return;

      titleEl.textContent  = data.title;
      artistEl.textContent = data.artist;
      link.href            = data.songUrl || '#';

      if (data.albumArt) {
        art.src = data.albumArt;
        art.alt = `${data.title} album art`;
      }

      label.textContent    = data.isPlaying ? 'LISTENING NOW' : 'LAST PLAYED';
      eq.style.display     = data.isPlaying ? 'flex' : 'none';
      widget.style.display = 'block';
    } catch {
      // Fail silently — widget stays hidden
    }
  }

  fetchNowPlaying();

  let timer = setInterval(fetchNowPlaying, 30_000);

  document.addEventListener('visibilitychange', () => {
    if (document.hidden) {
      clearInterval(timer);
    } else {
      fetchNowPlaying();
      timer = setInterval(fetchNowPlaying, 30_000);
    }
  });
})();
</script>
