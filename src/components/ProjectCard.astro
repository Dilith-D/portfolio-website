---
interface Props {
  title: string;
  problem: string;
  stack: string[];
  year: string;
  slug: string;
  liveUrl?: string;
  stagger?: number;
}

const { title, problem, stack, year, slug, liveUrl, stagger = 0 } = Astro.props;
const stackLabel = stack.map(s => s.toUpperCase()).join('  ·  ');
---

<div class="reveal" style={`transition-delay: calc(${stagger} * 90ms)`}>
<div class="card-wrap">
  <span class="edge-light" aria-hidden="true"></span>
  <div class="card-body">
    <p class="card-tags">{year}&nbsp;&nbsp;·&nbsp;&nbsp;{stackLabel}</p>
    <h3 class="card-title">{title}</h3>
    <p class="card-desc">{problem}</p>
    <div style="display:flex; flex-direction:column; gap:0.5rem; margin-top:0.25rem;">
      <a
        href={`/projects/${slug}`}
        class="card-link"
      >
        See how I built it <span aria-hidden="true">→</span>
      </a>
      {liveUrl && (
        <a
          href={liveUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="card-link"
          data-track="project_live"
          data-slug={slug}
        >
          Try it live <span aria-hidden="true">→</span>
        </a>
      )}
    </div>
  </div>
</div>
</div>
