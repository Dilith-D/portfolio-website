---
import Base from '../layouts/Base.astro';
import CaseStudyCard from '../components/CaseStudyCard.astro';
import EssayCard from '../components/EssayCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ToolOrbitArc from '../components/ToolOrbitArc.astro';

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Dilith Dinesh",
  "jobTitle": "Customer Product Manager",
  "description": "Product Manager and product operator at the boundary between customer reality and product systems. Specializes in translating field service operations into scalable product capabilities at Zuper, a B2B SaaS platform for field service management. One year of experience as a Forward Deployed Engineer followed by one year as a Customer Product Manager. Building toward Associate Product Manager and AI-first product roles at Series A/B companies.",
  "url": "https://dilithdinesh.com",
  "sameAs": ["https://linkedin.com/in/dilithdinesh"],
  "knowsAbout": [
    "Product Management",
    "Associate Product Management",
    "Field Service Management",
    "B2B SaaS",
    "AI-native product development",
    "Vertical SaaS",
    "Product Operations",
    "Customer Success",
    "Generative AI",
    "Product Strategy"
  ],
  "alumniOf": {
    "@type": "CollegeOrUniversity",
    "name": "VIT University"
  },
  "worksFor": {
    "@type": "Organization",
    "name": "Zuper",
    "url": "https://zuper.co"
  }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Who is Dilith Dinesh?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Dilith Dinesh is a Customer Product Manager at Zuper, a B2B SaaS platform for field service management. He works at the intersection of customer operations and product systems, translating what breaks in the field into scalable product capabilities. He has one year of experience as a Forward Deployed Engineer and one year as a product manager, with a Computer Science background from VIT University."
      }
    },
    {
      "@type": "Question",
      "name": "What does Dilith Dinesh specialize in?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Dilith Dinesh specializes in translating operational reality into product decisions — specifically vertical SaaS for field service industries, customer-facing product management, and building the connective tissue between what customers experience and what product teams build."
      }
    },
    {
      "@type": "Question",
      "name": "What is Zuper and what has Dilith Dinesh built there?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Zuper is a field service management platform for contractors and service businesses. Dilith built the roofing vertical from scratch — including the golden account architecture that reduced onboarding time by more than 50%, and a configurable multi-tenant booking system that compressed a feature prioritization decision from weeks to hours."
      }
    },
    {
      "@type": "Question",
      "name": "What is Pulseboard?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Pulseboard is a personal work-tracking and reflection tool for product managers, built by Dilith Dinesh. It solves the problem of scattered work not accumulating into a visible narrative — with daily activity logging, effort distribution visualizations, and AI-generated performance summaries. Built with Lovable and Supabase in 2025."
      }
    },
    {
      "@type": "Question",
      "name": "What is Iris?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Iris is a cross-device private file and message transfer app built by Dilith Dinesh in 2026. It solves multi-device file transfer without platform lock-in, using 8-character pairing codes, session-based connections, and a multi-tenant backend. Built with React 18, TypeScript, and Supabase."
      }
    },
    {
      "@type": "Question",
      "name": "What writing is on dilithdinesh.com?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The site includes product teardowns and operational frameworks. Current essays: an analysis of how Rapido built habit loops and supply-side network effects in India's bike taxi market (January 2026), and a breakdown of why Spotify Wrapped became a cultural ritual while most imitators copy the format but miss the emotional architecture (December 2025)."
      }
    }
  ]
};

const marqueeItems = [
  "Zuper",
  "Field Service Management",
  "B2B SaaS",
  "Built the roofing vertical from 0 to 1",
  "AI Product Manager",
  "Voice Agents · AI Systems",
  "Chennai",
  "Forward Deployed Engineer → Product Manager",
];
---

<Base
  title="Dilith Dinesh — Product Manager"
  description="Product Manager at Zuper building the roofing vertical in field service management. Case studies in B2B SaaS product operations, product teardowns, and build logs."
  schema={[personSchema, faqSchema]}
>

  <!-- ─── Hero ──────────────────────────────────────────────────── -->
  <section class="hero-section">
    <div class="hero-inner">

      <p class="hero-anim font-body text-[11px] font-medium tracking-[0.18em] uppercase text-secondary mb-7" style="animation-delay: 0.05s">
        Customer Product Manager · Zuper
      </p>

      <h1 class="hero-name hero-anim leading-none text-primary" style="animation-delay: 0.15s; font-family: 'Instrument Serif', serif; font-weight: 400; letter-spacing: -0.035em;">
        <span id="hero-name" style="cursor:default;">Dilith Dinesh</span>
      </h1>

      <p id="triple-click-msg" class="font-body text-sm text-secondary italic mt-3" style="opacity:0; transition:opacity 300ms ease;">
        Three clicks. You're either very bored or very thorough. Either way — hello.
      </p>

      <p class="hero-anim hero-tagline font-display italic text-secondary" style="animation-delay: 0.3s; max-width: 580px;">
        Product operator at the <span class="boundary-egg" style="position:relative; cursor:help; text-decoration-line:underline; text-underline-offset:3px; text-decoration-style:dotted;">boundary<span class="boundary-tip" style="display:none; position:absolute; bottom:calc(100% + 8px); left:50%; transform:translateX(-50%); background:var(--color-primary); color:var(--color-background); font-size:13px; font-family:'Inter',sans-serif; white-space:nowrap; padding:6px 12px; border-radius:4px; pointer-events:none; z-index:100;">This is where the interesting problems live.</span></span> between
        customer reality and product systems.
      </p>

      <p class="hero-anim font-body text-base text-secondary mt-6" style="animation-delay: 0.45s; max-width: 460px;">
        I translate what breaks in the field into capabilities that scale —
        and build AI systems to show how I think about them.
      </p>

      <div class="hero-anim hero-buttons" style="animation-delay: 0.6s">
        <a href="/work" class="hero-btn-primary">See my work →</a>
        <a href="/writing" class="hero-btn-ghost">Read my thinking</a>
      </div>

      <div class="hero-anim" style="animation-delay: 0.72s; margin-top: 1.25rem;">
        <a
          href="https://linkedin.com/in/dilithdinesh"
          target="_blank"
          rel="noopener noreferrer"
          class="hero-linkedin font-body text-sm text-secondary"
        >
          → LinkedIn
        </a>
      </div>

      <!-- Moon/Sun: absolutely positioned right side, out of text flow -->
      <div class="hero-moon-positioner">
        <div class="hero-moon-anim">
          <div class="hero-moon-wrap">
            <button id="heroCta" class="hero-moon-btn" aria-label="Talk to my AI agent">
              Talk to my AI
            </button>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- ─── Animated Marquee ──────────────────────────────────────── -->
  <div class="marquee-wrap" aria-hidden="true">
    <div class="marquee-track">
      {[...marqueeItems, ...marqueeItems].map((item) => (
        <span class="marquee-item">{item} ·</span>
      ))}
    </div>
  </div>

  <!-- ─── Signal Section ────────────────────────────────────────── -->
  <section class="signal-section">
    <div class="max-w-[1100px] mx-auto px-6 py-[80px]">
      <div style="max-width: 660px;" class="reveal">
        <p class="font-prose text-lg text-secondary" style="line-height: 1.88;">
          Most product teams learn about customer problems through
          tickets, NPS scores, and quarterly reviews.
        </p>
        <p class="font-prose text-lg text-secondary mt-6" style="line-height: 1.88;">
          I've spent two years inside the operational layer —
          sitting with contractors, mapping how they actually
          collect money, watching where workflows break before
          anyone files a bug report.
        </p>
        <p class="font-prose text-lg text-secondary mt-6" style="line-height: 1.88;">
          That proximity changes how I think about product
          decisions. Not every problem needs a feature.
          Not every feature request is the actual problem.
          The real work is finding the gap between what
          people say they want and what would actually help them.
        </p>
        <p class="font-prose text-lg text-secondary mt-6" style="line-height: 1.88;">
          That's the kind of product thinking I'm building toward.
        </p>
      </div>
    </div>
  </section>

  <!-- ─── AI Toolkit ───────────────────────────────────────────── -->
  <section class="toolkit-section" id="ai-stack-section">
    <div class="max-w-[1100px] mx-auto px-6 py-[80px] flex flex-col items-center text-center">
      <p class="eyebrow">Stack</p>
      <h2 class="section-title" style="margin-bottom: 1.5rem;">The AI PM toolkit.</h2>
      <p class="font-body text-sm text-secondary mb-12" style="max-width: 420px; line-height: 1.75;">
        Models, automation platforms, and product tools I reach for every week.
      </p>
      <ToolOrbitArc />
    </div>
  </section>

  <!-- ─── Work / Writing / Projects / Footer CTA ───────────────── -->
  <div class="max-w-[1100px] mx-auto px-6">

    <!-- Work Preview -->
    <section class="py-[80px]">
      <div class="mb-10">
        <p class="eyebrow">Work</p>
        <h2 class="section-title">Not success stories.<br>Decision logs.</h2>
      </div>

      <div class="bento-grid">
        <CaseStudyCard
          featured
          title="The Roofing Vertical"
          tags={["ZUPER", "FIELD SERVICE", "VERTICAL BUILD"]}
          description="The roofing vertical at Zuper didn't exist. No architecture, no repeatable process, no foundation for the product to grow on. I built it — from first discovery call to cloneable system."
          slug="golden-account-model"
          stagger={0}
        />
        <div class="bento-stack">
          <CaseStudyCard
            title="The Stopgap That Knew Its Place"
            tags={["ZUPER", "PRODUCT JUDGMENT"]}
            description="Roofing customers needed booking before the roadmap was ready. I built the interim solution — and designed it to be replaced."
            slug="booking-stopgap"
            stagger={1}
          />
          <CaseStudyCard
            title="The AI Shopping Buddy"
            tags={["E-COMMERCE", "AI SYSTEMS"]}
            description="Personal friction became a weekend build plan: an AI shopping layer any e-commerce can embed."
            slug="ai-shopping-buddy"
            stagger={2}
          />
        </div>
      </div>

      <div class="mt-8">
        <a href="/work" class="card-link" style="margin-top:0;">
          View all work <span aria-hidden="true">→</span>
        </a>
      </div>
    </section>

    <hr class="border-t border-border my-0" />

    <!-- Writing Preview -->
    <section class="py-[80px]">
      <div class="mb-12">
        <p class="eyebrow">Writing</p>
        <h2 class="section-title">Teardowns, field notes,<br>and frameworks.</h2>
      </div>

      <div>
        <EssayCard
          title="What B2B SaaS Can Learn From India's Fastest-Growing Mobility App"
          hook="Rapido nailed the habit loop. But they're still optimizing for the ideal user — not the actual one."
          date="Jan 2026"
          tags={["Teardown"]}
          slug="rapido-teardown"
        />
        <EssayCard
          title="How Spotify Turned Usage Data Into an Annual Identity Ritual"
          hook="Most imitators copy the format. They miss the emotional architecture underneath."
          date="Dec 2025"
          tags={["Teardown"]}
          slug="spotify-wrapped"
        />
      </div>

      <div class="mt-10">
        <a
          href="/writing"
          class="group font-body text-[15px] font-medium text-primary inline-flex items-center gap-1"
        >
          Read all writing
          <span class="inline-block transition-transform duration-150 ease-in-out group-hover:translate-x-1">→</span>
        </a>
      </div>
    </section>

    <hr class="border-t border-border my-0" />

    <!-- Projects Preview -->
    <section class="py-[80px]">
      <div class="mb-12">
        <p class="eyebrow">Projects</p>
        <h2 class="section-title">Personal friction,<br>built into tools.</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <ProjectCard
          title="Iris"
          problem="I work across four devices. Every day I need to move something between them — a screenshot, a file, a link. Every existing solution added friction I didn't want. So I built one."
          stack={["React 18", "TypeScript", "Supabase"]}
          year="2026"
          slug="iris"
          liveUrl="https://d-chat.lovable.app"
          stagger={0}
        />
        <ProjectCard
          title="SuperPilot"
          problem="B2B sales reps lose 2 hours a day across 6 deal handoffs. The data to fix it exists. I built the AI layer that synthesizes it into memory."
          stack={["React", "TanStack", "Claude Sonnet", "Deepgram"]}
          year="2026"
          slug="superpilot"
          stagger={1}
        />
        <ProjectCard
          title="The Voice Agent"
          problem="A contact form would tell you I'm interested in AI product work. A voice agent shows you how I think about it. So I built one — and documented every decision behind it."
          stack={["VAPI", "Deepgram", "ElevenLabs", "GPT-4o Mini"]}
          year="2026"
          slug="voice-agent"
          stagger={2}
        />
      </div>

      <div class="mt-10">
        <a
          href="/projects"
          class="group font-body text-[15px] font-medium text-primary inline-flex items-center gap-1"
        >
          See all projects
          <span class="inline-block transition-transform duration-150 ease-in-out group-hover:translate-x-1">→</span>
        </a>
      </div>
    </section>


  </div>


  <!-- Easter Egg: "2 years" proof strip tooltip (element removed; guard kept to avoid errors) -->
  <script>
    const yearsEgg = document.querySelector('.years-egg');
    const yearsTip = document.querySelector('.years-tip');
    if (yearsEgg) {
      yearsEgg.addEventListener('mouseenter', () => { yearsTip.style.display = 'block'; window.markEggFound?.('years-tooltip'); });
      yearsEgg.addEventListener('mouseleave', () => yearsTip.style.display = 'none');
    }
  </script>

  <!-- Easter Egg 2: boundary tooltip -->
  <script>
    const egg = document.querySelector('.boundary-egg');
    const tip = document.querySelector('.boundary-tip');
    egg.addEventListener('mouseenter', () => { tip.style.display = 'block'; window.markEggFound?.('boundary-hover'); });
    egg.addEventListener('mouseleave', () => tip.style.display = 'none');
  </script>

  <!-- Easter Egg 7: triple-click hero name -->
  <script>
    let clicks = 0;
    document.getElementById('hero-name').addEventListener('click', () => {
      clicks++;
      if (clicks === 3) {
        const msg = document.getElementById('triple-click-msg');
        msg.style.opacity = '1';
        setTimeout(() => { msg.style.opacity = '0'; }, 3000);
        window.markEggFound?.('triple-click');
        clicks = 0;
      }
    });
  </script>

  <!-- Voice trigger -->
  <script>
    document.getElementById('heroCta')?.addEventListener('click', () => {
      document.dispatchEvent(new CustomEvent('voice:toggle', { bubbles: true, detail: { trigger: 'hero_cta' } }));
    });
  </script>

  <!-- AI stack viewport tracking -->
  <script>
    const _stackSection = document.getElementById('ai-stack-section');
    if (_stackSection) {
      const _stackObserver = new IntersectionObserver(([entry]) => {
        if (entry.isIntersecting) {
          window.posthog?.capture('ai_stack_viewed');
          window.gtag?.('event', 'ai_stack_viewed');
          _stackObserver.disconnect();
        }
      }, { threshold: 0.3 });
      _stackObserver.observe(_stackSection);
    }
  </script>




<style>
/* ── Hero section ────────────────────────────────────────── */
.hero-section {
  display: flex;
  justify-content: center;
}

.hero-inner {
  position: relative;
  min-height: 100dvh;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 9rem 3rem 7rem;
  max-width: 1100px;
  width: 100%;
}

.hero-name {
  font-size: clamp(72px, 9vw, 112px);
  letter-spacing: -0.04em;
  margin-top: 0;
}

.hero-tagline {
  font-size: clamp(20px, 2.2vw, 30px);
  margin-top: 1.5rem;
}

/* ── Hero stagger entry ──────────────────────────────────── */
.hero-anim {
  opacity: 0;
  transform: translateY(18px);
  animation: fadeUp 0.55s var(--ease-ui) both;
}

@keyframes fadeUp {
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@media (prefers-reduced-motion: reduce) {
  .hero-anim {
    animation-duration: 0.01ms !important;
  }
}

/* ── Hero buttons ────────────────────────────────────────── */
.hero-buttons {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 0.75rem;
  margin-top: 2.5rem;
}

.hero-btn-primary {
  font-family: 'Inter', sans-serif;
  font-size: 0.9375rem;
  font-weight: 500;
  color: var(--color-cta-fg);
  background: var(--color-cta-bg);
  padding: 0.75rem 1.5rem;
  border-radius: 9999px;
  text-decoration: none;
  transition:
    opacity 150ms var(--ease-ui),
    transform 120ms var(--ease-ui);
}

.hero-btn-ghost {
  font-family: 'Inter', sans-serif;
  font-size: 0.9375rem;
  font-weight: 500;
  color: var(--color-primary);
  background: transparent;
  padding: 0.75rem 1.5rem;
  border-radius: 9999px;
  border: 1px solid var(--color-border);
  text-decoration: none;
  transition:
    background 150ms var(--ease-ui),
    transform 120ms var(--ease-ui);
}

@media (hover: hover) and (pointer: fine) {
  .hero-btn-primary:hover { opacity: 0.88; }
  .hero-btn-ghost:hover   { background: var(--color-surface); }
}

.hero-btn-primary:active,
.hero-btn-ghost:active {
  transform: scale(0.97);
}

/* ── Moon / Sun Button ───────────────────────────────────── */

/* Absolute positioner — pulls out of text flow into right half */
.hero-moon-positioner {
  position: absolute;
  right: 60px;
  top: 50%;
  transform: translateY(-50%);
}

/* Opacity-only fade — no translateY (would conflict with centering) */
.hero-moon-anim {
  opacity: 0;
  animation: moonFadeIn 1s var(--ease-ui) 0.72s forwards;
}

@keyframes moonFadeIn {
  to { opacity: 1; }
}

@media (prefers-reduced-motion: reduce) {
  .hero-moon-anim { animation-duration: 0.01ms !important; }
}

/* Hide on screens too narrow for a right-side orb */
@media (max-width: 900px) {
  .hero-moon-positioner { display: none; }
}

/* Wrapper holds the glow (correct stacking context) */
.hero-moon-wrap {
  position: relative;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

/* Dark mode: deep indigo/blue night-sky atmospheric glow */
.hero-moon-wrap::before {
  content: '';
  position: absolute;
  width: 420px;
  height: 420px;
  border-radius: 50%;
  background: radial-gradient(
    circle at center,
    rgba(52, 32, 190, 0.65)  0%,
    rgba(34, 18, 148, 0.46) 20%,
    rgba(18,  9,  88, 0.25) 42%,
    rgba( 8,  4,  40, 0.08) 62%,
    transparent 75%
  );
  pointer-events: none;
  animation: moonAura 4s ease-in-out infinite;
}

/* Light mode: warm amber/orange sun glow */
html:not(.dark) .hero-moon-wrap::before {
  background: radial-gradient(
    circle at center,
    rgba(255, 165,   0, 0.58)  0%,
    rgba(255, 100,   0, 0.30) 28%,
    rgba(200,  60,   0, 0.11) 52%,
    transparent 72%
  );
}

@keyframes moonAura {
  0%, 100% { opacity: 0.72; transform: scale(1);    }
  50%       { opacity: 1.0;  transform: scale(1.08); }
}

@media (prefers-reduced-motion: reduce) {
  .hero-moon-wrap::before { animation: none; }
}

/* ── The orb itself ──────────────────────────────────────── */
.hero-moon-btn {
  position: relative;
  z-index: 1;
  width: 120px;
  height: 120px;
  border-radius: 50%;

  /* Dark mode: white/silver moon surface */
  background: radial-gradient(
    circle at 38% 32%,
    rgba(255, 255, 255, 1)  0%,
    rgba(238, 238, 234, 1) 35%,
    rgba(210, 210, 205, 1) 70%,
    rgba(188, 188, 183, 1) 100%
  );
  border: none;
  cursor: pointer;

  color: #1A1614;
  font-family: 'Inter', sans-serif;
  font-size: 0.8125rem;
  font-weight: 500;
  line-height: 1.35;
  letter-spacing: 0.01em;
  text-align: center;
  padding: 0 14px;

  display: flex;
  align-items: center;
  justify-content: center;

  box-shadow:
    0 0 0 1px rgba(220, 220, 215, 0.50),
    0 0 22px rgba(200, 200, 195, 0.18);

  transition:
    box-shadow 200ms var(--ease-ui),
    transform  150ms var(--ease-ui);
}

@media (hover: hover) and (pointer: fine) {
  .hero-moon-btn:hover {
    box-shadow:
      0 0 0 1px rgba(220, 220, 215, 0.70),
      0 0 32px rgba(200, 200, 195, 0.28);
  }
}

.hero-moon-btn:active {
  transform: scale(0.95);
}

/* Dark mode: off-axis highlight — moonlight from upper-left */
.hero-moon-btn::after {
  content: '';
  position: absolute;
  inset: 0;
  border-radius: 50%;
  background: radial-gradient(
    circle at 34% 28%,
    rgba(255, 255, 255, 0.55) 0%,
    transparent 50%
  );
  pointer-events: none;
}

/* Light mode: real sun photo */
html:not(.dark) .hero-moon-btn {
  background: url('/sun.png') center / cover no-repeat;
  color: white;
  text-shadow: 0 1px 4px rgba(0, 0, 0, 0.65), 0 0 8px rgba(0, 0, 0, 0.4);
  box-shadow:
    0 0 0 2px rgba(255, 205, 0, 0.40),
    0 0 28px rgba(255, 175, 0, 0.25);
}

/* Light mode: no fake highlight — real photo handles it */
html:not(.dark) .hero-moon-btn::after {
  background: none;
}

@media (hover: hover) and (pointer: fine) {
  .hero-btn-primary:hover { opacity: 0.88; }
  .hero-btn-ghost:hover   { background: var(--color-surface); }
  .hero-moon-wrap:hover .hero-moon-btn {
    box-shadow:
      0 0 0 1px rgba(230, 230, 225, 0.75),
      0 0 32px rgba(210, 210, 205, 0.28);
  }
  html:not(.dark) .hero-moon-wrap:hover .hero-moon-btn {
    box-shadow:
      0 0 0 2px rgba(255, 210, 0, 0.60),
      0 0 36px rgba(255, 175, 0, 0.35);
  }
  .hero-linkedin:hover { color: var(--color-primary); }
}

.hero-moon-btn:active {
  transform: scale(0.97);
}

.hero-btn-primary:active,
.hero-btn-ghost:active {
  transform: scale(0.97);
}

.hero-linkedin {
  text-decoration: none;
  transition: color 150ms var(--ease-ui);
}

/* ── Animated marquee ────────────────────────────────────── */
.marquee-wrap {
  position: relative;
  overflow: hidden;
  border-top: 1px solid var(--color-border);
  border-bottom: 1px solid var(--color-border);
  padding: 0.875rem 0;
}

.marquee-wrap::before,
.marquee-wrap::after {
  content: '';
  position: absolute;
  top: 0;
  bottom: 0;
  width: 100px;
  z-index: 1;
  pointer-events: none;
}

.marquee-wrap::before {
  left: 0;
  background: linear-gradient(to right, var(--color-background), transparent);
}

.marquee-wrap::after {
  right: 0;
  background: linear-gradient(to left, var(--color-background), transparent);
}

.marquee-track {
  display: flex;
