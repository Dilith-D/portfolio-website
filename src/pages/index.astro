---
import Base from '../layouts/Base.astro';
import CaseStudyCard from '../components/CaseStudyCard.astro';
import EssayCard from '../components/EssayCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ToolOrbitArc from '../components/ToolOrbitArc.astro';
import VoiceAssistant from '../components/VoiceAssistant';

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Dilith Dinesh",
  "jobTitle": "Associate Product Manager",
  "description": "Product operator at the boundary between customer reality and product systems. Associate Product Manager at VoiceStack, an AI-powered phone platform for dental practices and DSOs. Previously spent two years at Zuper, a B2B SaaS field service management platform. One year as a Forward Deployed Engineer, then as a Customer Product Manager where he built the roofing vertical from zero. Works on vertical SaaS, voice AI, and the operational layer where revenue quietly leaks.",
  "url": "https://dilithdinesh.com",
  "sameAs": ["https://linkedin.com/in/dilithdinesh"],
  "knowsAbout": [
    "Product Management",
    "Associate Product Management",
    "Vertical SaaS",
    "Voice AI",
    "Conversational AI",
    "Healthcare Technology",
    "Field Service Management",
    "B2B SaaS",
    "AI-native product development",
    "Product Operations",
    "Generative AI",
    "Product Strategy"
  ],
  "alumniOf": {
    "@type": "CollegeOrUniversity",
    "name": "VIT University"
  },
  "worksFor": {
    "@type": "Organization",
    "name": "VoiceStack",
    "url": "https://voicestack.com"
  }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Who is Dilith Dinesh?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Dilith Dinesh is an Associate Product Manager at VoiceStack, an AI-powered phone platform for dental practices and DSOs. He previously spent two years at Zuper, a B2B SaaS field service management platform, first as a Forward Deployed Engineer, then as a Customer Product Manager where he built the roofing vertical from zero. He works at the intersection of customer operations and product systems, and has a Computer Science background from VIT University."
      }
    },
    {
      "@type": "Question",
      "name": "What does Dilith Dinesh specialize in?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Dilith Dinesh specializes in translating operational reality into product decisions: vertical SaaS, AI-native products, and the operational layer where revenue quietly leaks. In field service that layer was dispatch and the job itself. In healthcare it is the inbound patient call. He builds the connective tissue between what customers experience and what product teams build."
      }
    },
    {
      "@type": "Question",
      "name": "Where does Dilith Dinesh work now?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Dilith Dinesh joined VoiceStack as an Associate Product Manager in August 2026. VoiceStack builds an AI-powered phone platform for dental practices and DSOs, combining enterprise VoIP, conversational AI, call scoring, opportunity detection, and marketing attribution, with integrations into practice management systems including Dentrix, Eaglesoft, Open Dental, and CareStack."
      }
    },
    {
      "@type": "Question",
      "name": "Why did Dilith Dinesh move from field service to healthcare?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Two years inside one vertical taught him that the leverage in vertical SaaS is rarely in the feature list. It is in the operational layer nobody has instrumented yet. In field service, the job is won or lost at dispatch. In dental, the patient is won or lost on the inbound call, where practices miss a large share of calls and most callers never leave a voicemail. Same structural problem, harder domain, with AI at the center rather than at the edges."
      }
    },
    {
      "@type": "Question",
      "name": "What is Zuper and what did Dilith Dinesh build there?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Zuper is a field service management platform for contractors and service businesses, where Dilith worked from 2024 to 2026. He built the roofing vertical from scratch, including the golden account architecture that reduced onboarding time by more than 50%, and a configurable multi-tenant booking system that compressed a feature prioritization decision from weeks to hours."
      }
    },
    {
      "@type": "Question",
      "name": "What is Pulseboard?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Pulseboard is a personal work-tracking and reflection tool for product managers, built by Dilith Dinesh. It solves the problem of scattered work not accumulating into a visible narrative, with daily activity logging, effort distribution visualizations, and AI-generated performance summaries. Built with Lovable and Supabase in 2025."
      }
    },
    {
      "@type": "Question",
      "name": "What is Iris?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Iris is a cross-device private file and message transfer app built by Dilith Dinesh in 2026. It solves multi-device file transfer without platform lock-in, using 8-character pairing codes, session-based connections, and a multi-tenant backend. Built with React 18, TypeScript, and Supabase."
      }
    },
    {
      "@type": "Question",
      "name": "What writing is on dilithdinesh.com?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The site includes product teardowns and operational frameworks. Current essays: an analysis of how Rapido built habit loops and supply-side network effects in India's bike taxi market (January 2026), and a breakdown of why Spotify Wrapped became a cultural ritual while most imitators copy the format but miss the emotional architecture (December 2025)."
      }
    }
  ]
};
---

<Base
  title="Dilith Dinesh · Product Manager"
  description="Associate Product Manager at VoiceStack, building voice AI for dental practices. Previously built the roofing vertical at Zuper. Case studies in vertical SaaS and product operations, teardowns, and build logs."
  schema={[personSchema, faqSchema]}
>

  <div class="max-w-[1100px] mx-auto px-6">

    <!-- ─── Hero ─────────────────────────────────────────────── -->
    <section class="pt-[120px] pb-[120px] border-b border-border">
      <div class="hero-grid">

        <!-- Left column -->
        <div class="hero-left">

          <!-- 1. Name: a label, not a headline. h1 for semantics only. -->
          <div class="hero-name-block">
            <h1 class="hero-eyebrow">
              <span id="hero-name" style="cursor:default;">Dilith Dinesh</span>
            </h1>
            <p id="triple-click-msg" class="hero-egg-msg">
              Three clicks. You're either very bored or very thorough. Either way, hello.
            </p>
          </div>

          <!-- 3. Positioning line: largest element on the page -->
          <p class="hero-position">
            Product operator at the <span class="boundary-egg" style="position:relative; cursor:help; text-decoration-line:underline; text-underline-offset:3px; text-decoration-style:dotted;">boundary<span class="boundary-tip" style="display:none; position:absolute; bottom:calc(100% + 8px); left:50%; transform:translateX(-50%); background:var(--color-primary); color:var(--color-background); font-size:13px; font-family:'Inter',sans-serif; white-space:nowrap; padding:6px 12px; border-radius:4px; pointer-events:none; z-index:100;">This is where the interesting problems live.</span></span> between customer reality and product systems.
          </p>

          <!-- 5. Tagline -->
          <p class="hero-tagline">
            I translate what breaks in the operational layer into capabilities that scale.
          </p>

          <!-- 7. Role block -->
          <dl class="hero-roles">
            <div class="hero-role">
              <dt>NOW</dt>
              <dd>Associate Product Manager, VoiceStack. Voice AI for dental practices.</dd>
            </div>
            <div class="hero-role">
              <dt>BEFORE</dt>
              <dd>Two years at Zuper. Built the roofing vertical from zero.</dd>
            </div>
          </dl>

          <!-- 9. CTA row: one button, then text links -->
          <div class="hero-cta">
            <a
              href="/work"
              class="font-body text-[15px] font-medium text-white bg-blue px-6 py-3 rounded-md transition-opacity duration-150 hover:opacity-90"
            >See my work →</a>
            <p class="hero-links">
              <a href="/writing">Read my thinking →</a>
              <span aria-hidden="true">·</span>
              <button id="heroCta" type="button">Talk to my AI →</button>
              <span aria-hidden="true">·</span>
              <a href="https://linkedin.com/in/dilithdinesh" target="_blank" rel="noopener noreferrer">LinkedIn →</a>
            </p>
          </div>

          <!-- 11. Proof strip -->
          <p class="hero-proof">
VoiceStack&nbsp;&nbsp;·&nbsp;&nbsp;Healthcare Voice AI&nbsp;&nbsp;·&nbsp;&nbsp;Previously Zuper, field service&nbsp;&nbsp;·&nbsp;&nbsp;Built the roofing vertical from 0 to 1&nbsp;&nbsp;·&nbsp;&nbsp;Chennai
          </p>
        </div>

        <!-- Right column -->
        <div class="hero-right">

          <img
            class="hero-portrait"
            src="/portrait.webp"
            alt="Illustrated portrait of Dilith Dinesh"
            width="180"
            height="206"
            loading="eager"
            decoding="async"
          />

          <div class="hero-board">
            <p class="hero-board-title">Current state</p>

            <div class="hero-board-group" data-state="shipped">
              <p class="hero-board-label">Shipped</p>
              <ul>
                <li><a href="/projects/iris">Iris, cross-device file transfer</a></li>
                <li><a href="/projects/pulseboard">Pulseboard, PM reflection system</a></li>
                <li><span>Voice assistant on this site</span></li>
              </ul>
            </div>

            <div class="hero-board-group" data-state="progress">
              <p class="hero-board-label">In progress</p>
              <ul>
                <li><span>First 90 days at VoiceStack</span></li>
                <li><span>Ask Dilith, site chatbot</span></li>
              </ul>
            </div>

            <div class="hero-board-group" data-state="exploring">
              <p class="hero-board-label">Exploring</p>
              <ul>
                <li><span>Why voice is the right interface for front-office work</span></li>
                <li><span>What field service taught me that transfers to healthcare</span></li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ─── Signal Section ────────────────────────────────────── -->
    <section class="py-[80px] border-b border-border">
      <div class="max-w-[740px]">
        <p class="font-prose text-lg leading-reading text-primary">
          Most product teams learn about customer problems through
          tickets, NPS scores, and quarterly reviews.
        </p>
        <p class="font-prose text-lg leading-reading text-primary mt-6">
          I spent two years inside the operational layer of one
          vertical, sitting with contractors, mapping how they
          actually collect money, watching where workflows break
          before anyone files a bug report.
        </p>
        <p class="font-prose text-lg leading-reading text-primary mt-6">
          What that taught me wasn't roofing. It was that the
          leverage in vertical software is almost never in the
          feature list. It's in the operational moment nobody
          has instrumented yet. It's the moment where a stretched
          human decides whether the business makes money that day.
        </p>
        <p class="font-prose text-lg leading-reading text-primary mt-6">
          In field service, that moment is dispatch. In dental,
          it's a phone ringing at a front desk that's already
          short-staffed. I'm at VoiceStack now, doing the same
          work in a harder domain, where the caller is often in
          pain, the compliance surface is real, and an AI that
          loops instead of helping is worse than no AI at all.
        </p>
        <p class="font-prose text-lg leading-reading text-primary mt-6">
          It took two years to learn the first vertical. I expect
          the second to take just as long, and I'd rather say that
          than pretend otherwise.
        </p>
      </div>
    </section>

    <!-- ─── Work Preview ─────────────────────────────────────── -->
    <section class="py-[80px]">
      <div class="mb-12">
        <h2 class="font-display text-[48px] font-medium leading-tight text-primary">Work</h2>
        <p class="font-body text-base text-secondary mt-3">Not success stories. Decision logs.</p>
        <p class="font-body text-sm text-secondary tracking-wide mt-6">
          Onboarding: 12–16 weeks → 15 days&nbsp;&nbsp;·&nbsp;&nbsp;30+ accounts on the golden account template&nbsp;&nbsp;·&nbsp;&nbsp;6 hours from problem to roadmap decision
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <CaseStudyCard
          title="The Roofing Vertical"
          tags={["ZUPER", "FIELD SERVICE", "VERTICAL BUILD"]}
          description="The roofing vertical at Zuper didn't exist. No architecture, no repeatable process, no foundation for the product to grow on. I built it, from first discovery call to cloneable system."
          slug="golden-account-model"
        />
        <CaseStudyCard
          title="The Stopgap That Knew Its Place"
          tags={["ZUPER", "FIELD SERVICE", "PRODUCT JUDGMENT"]}
          description="Roofing customers needed booking before the product roadmap was ready. I built the interim solution, and designed it to be replaced."
          slug="booking-stopgap"
        />
        <CaseStudyCard
          title="The AI Shopping Buddy"
          tags={["PERSONAL SPEC", "E-COMMERCE", "AI SYSTEMS"]}
          description="I was copy-pasting specs from Flipkart into Claude just to answer 'does this phone fit my needs?' That friction became a weekend build plan: an AI shopping layer that any e-commerce can embed."
          slug="ai-shopping-buddy"
        />
      </div>

      <div class="mt-10">
        <a
          href="/work"
          class="group font-body text-[15px] font-medium text-primary inline-flex items-center gap-1"
        >
          View all work
          <span class="inline-block transition-transform duration-150 ease-in-out group-hover:translate-x-1">→</span>
        </a>
      </div>
    </section>

    <hr class="border-t border-border my-0" />

    <!-- ─── Writing Preview ──────────────────────────────────── -->
    <section class="py-[80px]">
      <div class="mb-12">
        <h2 class="font-display text-[48px] font-medium leading-tight text-primary">Writing</h2>
        <p class="font-body text-base text-secondary mt-3">
          Product teardowns, field notes, and frameworks<br />
          from the boundary between operations and product.
        </p>
      </div>

      <div>
        <EssayCard
          title="What B2B SaaS Can Learn From India's Fastest-Growing Mobility App"
          hook="Rapido nailed the habit loop. But they're still optimizing for the ideal user. Not the actual one."
          date="Jan 2026"
          tags={["Teardown"]}
          slug="rapido-teardown"
        />
        <EssayCard
          title="How Spotify Turned Usage Data Into an Annual Identity Ritual"
          hook="Most imitators copy the format. They miss the emotional architecture underneath."
          date="Dec 2025"
          tags={["Teardown"]}
          slug="spotify-wrapped"
        />
      </div>

      <div class="mt-10">
        <a
          href="/writing"
          class="group font-body text-[15px] font-medium text-primary inline-flex items-center gap-1"
        >
          Read all writing
          <span class="inline-block transition-transform duration-150 ease-in-out group-hover:translate-x-1">→</span>
        </a>
      </div>
    </section>

    <hr class="border-t border-border my-0" />

    <!-- ─── Projects Preview ──────────────────────────────────── -->
    <section class="py-[80px]">
      <div class="mb-12">
        <h2 class="font-display text-[48px] font-medium leading-tight text-primary">Projects</h2>
        <p class="font-body text-base text-secondary mt-3">
          Personal friction,<br />
          built into tools.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <ProjectCard
          title="The Voice Agent"
          problem="Live on this site. You can talk to it. Latency you feel rather than measure, speech recognition that mangles proper nouns, knowing when the agent should stop talking and get a human. I built it before I had a professional reason to. It's why I had opinions about voice AI before I had experience in it."
          stack={["VAPI", "Deepgram", "ElevenLabs", "GPT-4o Mini"]}
          year="2026"
          slug="voice-agent"
        />
        <ProjectCard
          title="SuperPilot"
          problem="B2B sales reps lose 2 hours a day across 6 deal handoffs. The data to fix it exists. I built the AI layer that synthesizes it into memory."
          stack={["React", "TanStack", "Claude Sonnet", "Deepgram"]}
          year="2026"
          slug="superpilot"
        />
        <ProjectCard
          title="Iris"
          problem="I work across four devices. Every day I need to move something between them: a screenshot, a file, a link. Every existing solution added friction I didn't want. So I built one."
          stack={["React 18", "TypeScript", "Supabase"]}
          year="2026"
          slug="iris"
          liveUrl="https://d-chat.lovable.app"
        />
        <ProjectCard
          title="Delphi"
          problem="Foreign founders with Delaware C-Corps face a $25,000 penalty for missing Form 5472. Most don't know it exists. I built the tool that tells them exactly what they owe, before they talk to a CPA."
          stack={["Claude API", "Vanilla JS", "Vercel"]}
          year="2026"
          slug="delphi"
          liveUrl="https://delphi-tax.vercel.app"
        />
      </div>

      <div class="mt-10">
        <a
          href="/projects"
          class="group font-body text-[15px] font-medium text-primary inline-flex items-center gap-1"
        >
          See all projects
          <span class="inline-block transition-transform duration-150 ease-in-out group-hover:translate-x-1">→</span>
        </a>
      </div>
    </section>

    <hr class="border-t border-border my-0" />

    <!-- ─── AI Toolkit ────────────────────────────────────────── -->
    <section class="py-[80px] flex flex-col items-center text-center" id="ai-stack-section">
      <p class="font-body text-[11px] font-medium tracking-[0.18em] uppercase mb-3" style="color: var(--color-electric)">Stack</p>
      <h2 class="font-display text-[32px] font-medium leading-snug text-primary mb-3">The AI PM toolkit.</h2>
      <p class="font-body text-sm text-secondary mb-12" style="max-width: 420px; line-height: 1.75;">
        Models, automation platforms, and product tools I reach for every week.
      </p>
      <ToolOrbitArc />
    </section>


  </div>


  <!-- Easter Egg: boundary tooltip -->
  <script>
    const egg = document.querySelector('.boundary-egg');
    const tip = document.querySelector('.boundary-tip');
    egg?.addEventListener('mouseenter', () => { tip.style.display = 'block'; window.markEggFound?.('boundary-hover'); });
    egg?.addEventListener('mouseleave', () => { tip.style.display = 'none'; });
  </script>

  <!-- Easter Egg: triple-click hero name -->
  <script>
    let clicks = 0;
    document.getElementById('hero-name')?.addEventListener('click', () => {
      clicks++;
      if (clicks === 3) {
        const msg = document.getElementById('triple-click-msg');
        if (msg) { msg.style.opacity = '1'; setTimeout(() => { msg.style.opacity = '0'; }, 3000); }
        window.markEggFound?.('triple-click');
        clicks = 0;
      }
    });
  </script>

  <!-- Voice trigger from hero button -->
  <script>
    document.getElementById('heroCta')?.addEventListener('click', () => {
      document.dispatchEvent(new CustomEvent('voice:toggle', { bubbles: true, detail: { trigger: 'hero_cta' } }));
    });
  </script>

  <!-- AI stack viewport tracking -->
  <script>
    const _stackSection = document.getElementById('ai-stack-section');
    if (_stackSection) {
      const _obs = new IntersectionObserver(([e]) => {
        if (e.isIntersecting) { window.posthog?.capture('ai_stack_viewed'); _obs.disconnect(); }
      }, { threshold: 0.3 });
      _obs.observe(_stackSection);
    }
  </script>

  <style>
    /* ─── Hero ────────────────────────────────────────────────────
       Two columns on desktop. Below 1024px everything collapses to a
       single flex column and the portrait jumps between the positioning
       line and the tagline, so the fold is not pure text.
       display:contents on the two column wrappers is what lets the
       children re-order across columns without duplicating markup. */

    .hero-grid {
      display: grid;
      grid-template-columns: 1.2fr 0.8fr;
      gap: 64px;
      align-items: start;
    }

    /* ── Left column ── */

    .hero-name-block { position: relative; }

    .hero-eyebrow {
      font-family: 'JetBrains Mono', ui-monospace, monospace;
      font-size: 13px;
      font-weight: 400;
      line-height: 1.2;
      text-transform: uppercase;
      letter-spacing: 0.12em;
      color: var(--color-secondary);
    }

    /* Absolute so the easter egg message never shifts the layout. */
    .hero-egg-msg {
      position: absolute;
      top: calc(100% + 8px);
      left: 0;
      z-index: 3;
      opacity: 0;
      pointer-events: none;
      font-family: 'Inter', sans-serif;
      font-size: 13px;
      font-style: italic;
      color: var(--color-secondary);
      background: var(--color-background);
      padding: 3px 8px;
      border-radius: 4px;
      transition: opacity 300ms var(--ease-ui);
    }

    .hero-position {
      margin-top: 32px;
      max-width: 620px;
      font-family: 'Cabinet Grotesk', sans-serif;
      font-size: 56px;
      font-weight: 600;
      line-height: 1.05;
      letter-spacing: -0.02em;
      color: var(--color-primary);
    }

    .hero-tagline {
      margin-top: 24px;
      max-width: 480px;
      font-family: 'Lora', serif;
      font-size: 20px;
      font-style: italic;
      line-height: 1.5;
      color: var(--color-secondary);
    }

    .hero-roles {
      margin-top: 32px;
      font-family: 'JetBrains Mono', ui-monospace, monospace;
      font-size: 13px;
      line-height: 1.7;
    }

    .hero-role {
      display: grid;
      grid-template-columns: 84px 1fr;
    }

    .hero-role dt {
      text-transform: uppercase;
      letter-spacing: 0.08em;
      /* One step quieter than the value it labels. Derived from the token
         so the relationship holds in both themes. */
      color: color-mix(in srgb, var(--color-secondary) 62%, transparent);
    }

    .hero-role dd { color: var(--color-secondary); }

    .hero-cta { margin-top: 40px; }

    .hero-cta > a { display: inline-block; }

    .hero-links {
      margin-top: 24px;
      font-family: 'Inter', sans-serif;
      font-size: 14px;
      color: var(--color-secondary);
    }

    .hero-links a,
    .hero-links button {
      color: inherit;
      background: none;
      border: 0;
      padding: 0;
      font: inherit;
      cursor: pointer;
      transition: color 150ms var(--ease-ui);
    }

    .hero-links > span { margin: 0 12px; opacity: 0.5; }

    .hero-links a:active,
    .hero-links button:active { transform: scale(0.96); }

    @media (hover: hover) and (pointer: fine) {
      .hero-links a:hover,
      .hero-links button:hover { color: var(--color-primary); }
    }

    .hero-proof {
      margin-top: 40px;
      padding-top: 24px;
      border-top: 1px solid var(--color-border);
      font-family: 'Inter', sans-serif;
      font-size: 14px;
      line-height: 1.7;
      /* Highest-signal line in the hero. Deliberately not text-secondary. */
      color: color-mix(in srgb, var(--color-primary) 75%, transparent);
    }

    /* ── Right column ── */

    /* No border, radius, shadow or container. It sits on the background.
       Full-tone engraving with both white highlights and black hatching,
       so it composites correctly on cream and on near-black. Verified in
       both themes: no invert filter needed. */
    .hero-portrait {
      display: block;
      width: 180px;
      height: auto;
    }

    .hero-board { margin-top: 48px; }

    .hero-board-title {
      font-family: 'JetBrains Mono', ui-monospace, monospace;
      font-size: 11px;
      font-weight: 500;
      text-transform: uppercase;
      letter-spacing: 0.12em;
      color: var(--color-secondary);
    }

    .hero-board-group { margin-top: 16px; }

    .hero-board-label {
      font-family: 'JetBrains Mono', ui-monospace, monospace;
      font-size: 11px;
      font-weight: 500;
      text-transform: uppercase;
      letter-spacing: 0.12em;
      color: var(--color-secondary);
    }

    .hero-board-label::before {
      content: '';
      display: inline-block;
      width: 6px;
      height: 6px;
      border-radius: 50%;
      margin-right: 8px;
      vertical-align: middle;
      background: currentColor;
    }

    [data-state='shipped']   .hero-board-label::before { background: var(--color-blue); }
    [data-state='progress']  .hero-board-label::before { background: var(--color-status-amber); }
    [data-state='exploring'] .hero-board-label::before { background: var(--color-secondary); }

    .hero-board-group li {
      list-style: none;
      font-family: 'Inter', sans-serif;
      font-size: 15px;
      line-height: 1.9;
    }

    .hero-board-group li a {
      color: var(--color-primary);
      text-decoration: none;
      transition: color 150ms var(--ease-ui);
    }

    .hero-board-group li span { color: var(--color-secondary); }

    @media (hover: hover) and (pointer: fine) {
