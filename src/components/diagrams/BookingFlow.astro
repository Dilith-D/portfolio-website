---
---
<div class="diagram-wrap">
  <p class="diagram-label">Booking Widget — Four Modes</p>

  <div class="node node-dark">
    Contractor configures booking widget
  </div>

  <div class="v-line"></div>
  <div class="h-line"></div>

  <div class="modes-row">
    <div class="m-col">
      <div class="v-drop"></div>
      <div class="mode-card mode-card-chosen">
        <div class="mode-num">Mode 1</div>
        <div class="mode-name">Full Booking</div>
        <div class="mode-desc">Customer selects time, inspection created automatically</div>
      </div>
      <div class="mode-tag">High-volume, systemized contractors</div>
    </div>
    <div class="m-col">
      <div class="v-drop"></div>
      <div class="mode-card">
        <div class="mode-num">Mode 2</div>
        <div class="mode-name">Lead Intake</div>
        <div class="mode-desc">Customer submits info, team schedules manually</div>
      </div>
      <div class="mode-tag">Teams that qualify leads before scheduling</div>
    </div>
    <div class="m-col">
      <div class="v-drop"></div>
      <div class="mode-card">
        <div class="mode-num">Mode 3</div>
        <div class="mode-name">Customer-Only</div>
        <div class="mode-desc">Contact record created, no job or inspection</div>
      </div>
      <div class="mode-tag">CRM-first workflows</div>
    </div>
    <div class="m-col">
      <div class="v-drop"></div>
      <div class="mode-card">
        <div class="mode-num">Mode 4</div>
        <div class="mode-name">Job Without Scheduling</div>
        <div class="mode-desc">Job created immediately, no time selection</div>
      </div>
      <div class="mode-tag">Emergency / immediate dispatch</div>
    </div>
  </div>

  <div class="h-line"></div>
  <div class="v-line"></div>

  <div class="node node-dark">
    One widget. Contractor picks the mode. Deploys in under 2 minutes.
  </div>
</div>

<style>
  .diagram-wrap {
    background: var(--color-surface);
    border-radius: 8px;
    padding: 32px 28px;
    border-left: 2px solid var(--color-border);
    margin: 2rem 0;
    font-family: 'Inter', sans-serif;
  }
  .diagram-label {
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-secondary);
    margin-bottom: 24px;
  }
  .node {
    border-radius: 6px;
    padding: 16px 20px;
    border: 1px solid var(--color-border);
    background: var(--color-background);
    color: var(--color-primary);
    font-size: 14px;
    font-weight: 500;
    text-align: center;
  }
  .node-dark {
    background: var(--color-primary);
    color: #F9F7F4;
    border-color: var(--color-primary);
  }
  .v-line {
    width: 1px;
    height: 20px;
    background: var(--color-border);
    margin: 0 auto;
  }
  .h-line {
    height: 1px;
    background: var(--color-border);
  }
  .v-drop {
    width: 1px;
    height: 14px;
    background: var(--color-border);
    margin: 0 auto;
  }
  .modes-row {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr 1fr;
    gap: 8px;
  }
  .m-col {
    display: flex;
    flex-direction: column;
    align-items: stretch;
  }
  .mode-card {
    border-radius: 6px;
    border: 1px solid var(--color-border);
    background: var(--color-background);
    padding: 16px 14px;
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .mode-card-chosen {
    border-color: var(--color-blue);
  }
  .mode-card-chosen .mode-num {
    color: var(--color-blue);
  }
  .mode-num {
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-secondary);
    font-weight: 500;
  }
  .mode-name {
    font-size: 12px;
    font-weight: 600;
    color: var(--color-primary);
    line-height: 1.3;
  }
  .mode-desc {
    font-size: 11px;
    color: var(--color-secondary);
    line-height: 1.4;
  }
  .mode-tag {
    font-size: 10px;
    color: var(--color-secondary);
    text-align: center;
    padding: 6px 4px 0;
    line-height: 1.4;
  }
  @media (max-width: 640px) {
    .modes-row {
      grid-template-columns: 1fr 1fr;
    }
    .v-drop {
      display: none;
    }
    .h-line {
      display: none;
    }
  }
</style>
