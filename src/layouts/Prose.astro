---
import Base from './Base.astro';
import ReadingProgress from '../components/ReadingProgress.astro';

interface Props {
  title: string;
  description: string;
  date?: string;
  readTime?: string;
  role?: string;
  summary?: string;
  tags?: string[];
  ogImage?: string;
}

const { title, description, date, readTime, role, summary, tags = [], ogImage } = Astro.props;

const meta = [date, readTime, role].filter(Boolean).join(' · ');
---

<Base title={title} description={description} ogImage={ogImage}>
  <ReadingProgress />

  <slot name="backnav">
    <div class="max-w-[740px] mx-auto px-6 pt-[100px]"><a href="/writing" class="font-body text-sm text-secondary hover:text-primary transition-colors duration-150">← Back to writing</a></div>
  </slot>

  <article class="pt-8 pb-20 px-6">
    <div class="max-w-[740px] mx-auto">

      {tags.length > 0 && (
        <p class="font-body text-xs tracking-widest uppercase text-secondary mb-3">
          {tags.join('  ·  ')}
        </p>
      )}

      <h1 class="font-display text-5xl md:text-[48px] font-semibold text-primary leading-tight">
        {title}
      </h1>

      {summary && (
        <p class="font-prose text-xl italic text-secondary mt-4">
          {summary}
        </p>
      )}

      {meta && (
        <p class="font-body text-sm text-secondary mt-4">
          {meta}
        </p>
      )}

      <hr class="border-t border-border mt-8 mb-12" />

      <div class="prose">
        <slot />
      </div>

    </div>
  </article>

  <!-- Easter Egg: Fast reader toast -->
  {readTime && (
    <script>
      (function() {
        const slug = window.location.pathname;
        const key = 'fast-read-' + slug;
        if (sessionStorage.getItem(key)) return;

        const arrival = Date.now();
        const MIN_TIME = 60 * 1000;

        function maybeShow() {
          const elapsed = Date.now() - arrival;
          if (elapsed < MIN_TIME) {
            sessionStorage.setItem(key, 'true');
            const toast = document.createElement('div');
            toast.innerText = 'That was fast. Some of this deserved more time.';
            toast.style.cssText = `
              position: fixed;
              bottom: 32px;
              left: 50%;
              transform: translateX(-50%) translateY(80px);
              background: #1A1A1A;
              color: #F9F7F4;
              font-family: 'Inter', sans-serif;
              font-size: 14px;
              padding: 12px 24px;
              border-radius: 6px;
              z-index: 9999;
              box-shadow: 0 8px 32px rgba(0,0,0,0.2);
              transition: transform 300ms ease, opacity 300ms ease;
              opacity: 0;
              pointer-events: none;
            `;
            document.body.appendChild(toast);
            requestAnimationFrame(() => {
              toast.style.transform = 'translateX(-50%) translateY(0)';
              toast.style.opacity = '1';
            });
            setTimeout(() => {
              toast.style.transform = 'translateX(-50%) translateY(80px)';
              toast.style.opacity = '0';
              setTimeout(() => toast.remove(), 300);
            }, 4000);
          }
        }

        document.addEventListener('visibilitychange', () => {
          if (document.visibilityState === 'hidden') maybeShow();
        });
        window.addEventListener('beforeunload', maybeShow);
      })();
    </script>
  )}
</Base>
