---
import Base from '../../layouts/Base.astro';
import EssayCard from '../../components/EssayCard.astro';
---

<Base
  title="Writing — Dilith Dinesh"
  description="Product teardowns and operational frameworks by Dilith Dinesh. Analysis of Rapido, Spotify Wrapped, and B2B SaaS product strategy — written from inside vertical software, first field service, now healthcare voice AI."
>
  <div class="max-w-[1100px] mx-auto px-6 pt-[120px] pb-[80px]">

    <div class="max-w-[740px] mb-[80px]">
      <h1 class="font-display text-[48px] font-medium leading-tight text-primary">Writing</h1>

      <p class="font-prose text-lg leading-reading text-primary mt-6">
        Product teardowns, operational frameworks,
        and thinking from the boundary between
        customer reality and product systems.
      </p>

      <p class="font-prose text-lg leading-reading text-primary mt-4">
        I write to make sense of what I'm seeing —
        not to perform expertise I don't have.
      </p>
    </div>

    <!-- Featured essay — full visual weight -->
    <a href="/writing/rapido-teardown" class="featured-essay reveal">
      <div class="featured-essay-meta">
        <span class="featured-label">— Featured</span>
        <span class="featured-date">JAN 2026  ·  TEARDOWN</span>
      </div>
      <h2 class="featured-essay-title">What B2B SaaS Can Learn From India's Fastest-Growing Mobility App</h2>
      <p class="featured-essay-hook">Rapido nailed the habit loop. But they're still optimizing for the ideal user — not the actual one.</p>
      <span class="featured-essay-cta">Read →</span>
    </a>

    <div class="writing-divider"></div>

    <p class="font-body text-xs tracking-widest uppercase text-secondary mb-2">All writing ↓</p>

    <div>
      <EssayCard
        title="How Spotify Turned Usage Data Into an Annual Identity Ritual"
        hook="Most imitators copy the format. They miss the emotional architecture underneath."
        date="Dec 2025"
        tags={["Teardown"]}
        slug="spotify-wrapped"
      />
    </div>

<style>
  .featured-essay {
    display: block;
    text-decoration: none;
    padding: 48px 0 56px;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    margin-bottom: 64px;
    max-width: 740px;
  }

  .featured-essay-meta {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-bottom: 20px;
  }

  .featured-label {
    font-family: 'Inter', sans-serif;
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-secondary);
  }

  .featured-date {
    font-family: 'Inter', sans-serif;
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-secondary);
  }

  .featured-essay-title {
    font-family: 'Instrument Serif', 'Cabinet Grotesk', serif;
    font-size: 2.25rem;
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--color-primary);
    margin-bottom: 20px;
    transition: color 180ms var(--ease-ui);
  }

  .featured-essay-hook {
    font-family: 'Lora', serif;
    font-size: 1.0625rem;
    font-style: italic;
    line-height: 1.7;
    color: var(--color-secondary);
    margin-bottom: 28px;
    max-width: 560px;
  }

  .featured-essay-cta {
    font-family: 'Inter', sans-serif;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-secondary);
    transition: color 180ms var(--ease-ui), transform 150ms var(--ease-ui);
    display: inline-block;
  }

  @media (hover: hover) and (pointer: fine) {
    .featured-essay:hover .featured-essay-title { color: var(--color-primary); }
    .featured-essay:hover .featured-essay-cta {
      color: var(--color-primary);
      transform: translateX(4px);
    }
  }

  .writing-divider {
    height: 1px;
    display: none; /* border-bottom on featured handles spacing */
  }

  @media (max-width: 640px) {
    .featured-essay { padding: 32px 0 40px; margin-bottom: 40px; }
    .featured-essay-title { font-size: 1.65rem; }
  }
</style>

  </div>
</Base>
