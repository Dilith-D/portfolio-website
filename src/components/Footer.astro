---
import EmailCopy from './EmailCopy.astro';
const year = new Date().getFullYear();
---

<style>
  .footer-link {
    position: relative;
  }
  .footer-link::after {
    content: '';
    position: absolute;
    bottom: -1px;
    left: 0;
    width: 0;
    height: 1px;
    background-color: #6B6B6B;
    transition: width 200ms ease;
  }
  .footer-link:hover::after {
    width: 100%;
  }
</style>

<footer class="border-t border-border py-12">
  <div class="max-w-[1100px] mx-auto px-6 flex flex-col md:flex-row items-center justify-between gap-4 text-center md:text-left">
    <EmailCopy email="dilithdinesh007@gmail.com" />
    <div class="flex flex-col items-center gap-1">
      <p class="font-body text-sm text-secondary">
        &copy; {year} Dilith Dinesh
      </p>
      <p class="font-body text-xs text-secondary">
        Built with Astro · Tailwind · Claude Code
      </p>
    </div>
    <a
      href="https://linkedin.com/in/dilithdinesh"
      target="_blank"
      rel="noopener noreferrer"
      class="footer-link font-body text-sm text-primary hover:text-blue transition-colors duration-150"
    >
      LinkedIn &rarr;
    </a>
  </div>
</footer>
