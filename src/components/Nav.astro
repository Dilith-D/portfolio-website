---
const navLinks = [
  { href: '/work',     label: 'Work' },
  { href: '/writing',  label: 'Writing' },
  { href: '/projects', label: 'Projects' },
  { href: '/now',      label: 'Now' },
  { href: '/about',    label: 'About' },
  { href: '/contact',  label: 'Contact' },
];

const currentPath = Astro.url.pathname;

function isActive(href: string) {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
}
---

<header
  id="nav"
  class="fixed top-0 left-0 right-0 z-50 h-16 transition-all duration-200 ease-in-out"
>
  <div class="max-w-[1100px] mx-auto px-6 h-full flex items-center justify-between">
    <!-- Logo -->
    <a
      href="/"
      class="font-display text-lg font-medium text-primary hover:text-accent transition-colors duration-150"
    >
      Dilith Dinesh
    </a>

    <!-- Right side: nav + toggle + hamburger -->
    <div class="flex items-center gap-4">

      <!-- Desktop nav links -->
      <nav class="hidden md:flex items-center gap-8" aria-label="Primary">
        {navLinks.map(({ href, label }) => (
          <a
            href={href}
            class={[
              'nav-desktop-link font-body text-sm tracking-wide transition-colors duration-150 relative',
              isActive(href)
                ? 'text-primary is-active'
                : 'text-secondary hover:text-primary',
            ].join(' ')}
          >
            {label}
          </a>
        ))}
      </nav>

      <!-- Theme toggle — desktop only -->
      <button
        id="theme-toggle"
        class="hidden md:flex items-center text-secondary hover:text-primary transition-colors duration-150"
        aria-label="Toggle dark mode"
      >
        <!-- Moon icon: shown in light mode -->
        <svg id="icon-moon" width="20" height="20" viewBox="0 0 20 20" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
          <path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"/>
        </svg>
        <!-- Sun icon: shown in dark mode, hidden by default -->
        <svg id="icon-sun" width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" class="hidden">
          <circle cx="10" cy="10" r="3" fill="currentColor"/>
          <line x1="10" y1="1"  x2="10" y2="3"  stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          <line x1="10" y1="17" x2="10" y2="19" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          <line x1="1"  y1="10" x2="3"  y2="10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          <line x1="17" y1="10" x2="19" y2="10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          <line x1="3.22"  y1="3.22"  x2="4.64"  y2="4.64"  stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          <line x1="15.36" y1="15.36" x2="16.78" y2="16.78" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          <line x1="3.22"  y1="16.78" x2="4.64"  y2="15.36" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          <line x1="15.36" y1="4.64"  x2="16.78" y2="3.22"  stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
      </button>

      <!-- Mobile hamburger -->
      <button
        id="hamburger"
        class="md:hidden flex flex-col gap-1.5 p-2 text-primary"
        aria-label="Open menu"
        aria-expanded="false"
      >
        <span class="block w-6 h-px bg-current transition-all duration-200" id="bar1"></span>
        <span class="block w-6 h-px bg-current transition-all duration-200" id="bar2"></span>
        <span class="block w-6 h-px bg-current transition-all duration-200" id="bar3"></span>
      </button>

    </div>
  </div>
</header>

<!-- Mobile overlay -->
<div
  id="mobile-menu"
  class="fixed inset-0 z-40 bg-background flex flex-col items-center justify-center
         opacity-0 pointer-events-none transition-opacity duration-200"
  aria-hidden="true"
>
  <!-- Close button — X icon, top right -->
  <button
    id="close-menu"
    class="absolute top-4 right-6 p-2 text-primary"
    aria-label="Close menu"
  >
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
      <line x1="18" y1="6" x2="6" y2="18"/>
      <line x1="6" y1="6" x2="18" y2="18"/>
    </svg>
  </button>

  <nav id="mobile-nav" class="flex flex-col items-center gap-8" aria-label="Mobile primary">
    {navLinks.map(({ href, label }) => (
      <a
        href={href}
        class="mobile-nav-link font-display text-4xl text-primary hover:text-accent transition-colors duration-150"
      >
        {label}
      </a>
    ))}
  </nav>
</div>

<style is:global>
  /* ── Desktop nav underline grow ─────────────────────────────── */
  .nav-desktop-link {
    position: relative;
  }
  .nav-desktop-link::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 0;
    height: 1px;
    background-color: currentColor;
    transition: width 200ms ease;
  }
  .nav-desktop-link:hover::after,
  .nav-desktop-link.is-active::after {
    width: 100%;
  }

  /* ── Mobile nav staggered entrance ──────────────────────────── */
  @keyframes mobileNavIn {
    from { opacity: 0; transform: translateY(8px); }
    to   { opacity: 1; transform: translateY(0);   }
  }
  #mobile-nav.mobile-nav-open .mobile-nav-link:nth-child(1) { animation: mobileNavIn 200ms ease forwards 0ms;   }
  #mobile-nav.mobile-nav-open .mobile-nav-link:nth-child(2) { animation: mobileNavIn 200ms ease forwards 40ms;  }
  #mobile-nav.mobile-nav-open .mobile-nav-link:nth-child(3) { animation: mobileNavIn 200ms ease forwards 80ms;  }
  #mobile-nav.mobile-nav-open .mobile-nav-link:nth-child(4) { animation: mobileNavIn 200ms ease forwards 120ms; }
  #mobile-nav.mobile-nav-open .mobile-nav-link:nth-child(5) { animation: mobileNavIn 200ms ease forwards 160ms; }
  #mobile-nav.mobile-nav-open .mobile-nav-link:nth-child(6) { animation: mobileNavIn 200ms ease forwards 200ms; }
  /* Reset opacity when menu is closed so animation replays on next open */
  #mobile-nav:not(.mobile-nav-open) .mobile-nav-link {
    opacity: 0;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const nav        = document.getElementById('nav')!;
    const hamburger  = document.getElementById('hamburger')!;
    const mobileMenu = document.getElementById('mobile-menu')!;
    const mobileNav  = document.getElementById('mobile-nav')!;
    const closeBtn   = document.getElementById('close-menu')!;

    // ── Scroll → nav background ──────────────────────────────────────
    function updateNav() {
      if (window.scrollY > 10) {
        nav.style.backgroundColor = 'var(--color-background, #F9F7F4)';
        nav.style.borderBottom = '1px solid var(--color-border, #E5E1DB)';
      } else {
        nav.style.backgroundColor = 'transparent';
        nav.style.borderBottom = 'none';
      }
    }
    window.addEventListener('scroll', updateNav, { passive: true });
    updateNav();

    // ── Mobile menu ──────────────────────────────────────────────────
    function openMobileMenu() {
      mobileMenu.classList.remove('opacity-0', 'pointer-events-none');
      mobileMenu.setAttribute('aria-hidden', 'false');
      hamburger.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
      mobileNav.classList.add('mobile-nav-open');
    }

    function closeMobileMenu() {
      mobileMenu.classList.add('opacity-0', 'pointer-events-none');
      mobileMenu.setAttribute('aria-hidden', 'true');
      hamburger.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
      mobileNav.classList.remove('mobile-nav-open');
    }

    hamburger.addEventListener('click', openMobileMenu);
    closeBtn.addEventListener('click', closeMobileMenu);

    document.querySelectorAll('.mobile-nav-link').forEach(link => {
      link.addEventListener('click', () => closeMobileMenu());
    });

    // ── Dark mode toggle (desktop only) ──────────────────────────────
    const themeToggle = document.getElementById('theme-toggle')!;
    const iconMoon    = document.getElementById('icon-moon')!;
    const iconSun     = document.getElementById('icon-sun')!;

    function updateIcons() {
      const isDark = document.documentElement.classList.contains('dark');
      iconMoon.classList.toggle('hidden', isDark);
      iconSun.classList.toggle('hidden', !isDark);
    }

    function toggleTheme() {
      const isDark = document.documentElement.classList.toggle('dark');
      localStorage.setItem('theme', isDark ? 'dark' : 'light');
      updateIcons();
      updateNav();
    }

    themeToggle.addEventListener('click', toggleTheme);
    updateIcons();
  });
</script>
