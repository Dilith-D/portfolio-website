---
import Prose from './Prose.astro';
import BackToTop from '../components/BackToTop.astro';

interface Props {
  title: string;
  description: string;
  date?: string;
  readTime?: string;
  role?: string;
  summary?: string;
  tags?: string[];
  ogImage?: string;
}

// In Astro 5, MDX layout frontmatter may be nested under .frontmatter
const fm: Record<string, any> = (Astro.props as any).frontmatter ?? Astro.props;
const { ...props } = fm;
---

<BackToTop />
<Prose {...props} backHref="/work" backLabel="Back to work">
  <slot />

  <!-- End navigation -->
  <hr class="border-t border-border my-20" />

  <nav class="flex items-center justify-between font-body text-sm font-medium text-primary" aria-label="Case study navigation">
    <a
      href="/work"
      class="hover:text-blue transition-colors duration-150 inline-flex items-center gap-1 group"
    >
      <span class="inline-block transition-transform duration-150 ease-in-out group-hover:-translate-x-1">&larr;</span>
      Back to all work
    </a>
    <a
      href="/work"
      class="hover:text-blue transition-colors duration-150"
    >
      More work &rarr;
    </a>
  </nav>

  <!-- 8 minutes on page -->
  <script>
    (function() {
      const key = 'dd-8min-' + window.location.pathname;
      if (sessionStorage.getItem(key)) return;
      setTimeout(() => {
        if (!sessionStorage.getItem(key)) {
          sessionStorage.setItem(key, 'true');
          window.markEggFound?.('case-study-8min', "Eight minutes. You read every word. That's the kind of attention I try to give every problem too.");
        }
      }, 8 * 60 * 1000);
    })();
  </script>

  <!-- Scroll to bottom -->
  <script>
    (function() {
      const key = 'dd-bottom-' + window.location.pathname;
      if (sessionStorage.getItem(key)) return;
      window.addEventListener('scroll', () => {
        const atBottom = window.scrollY + window.innerHeight >= document.documentElement.scrollHeight - 50;
        if (atBottom && !sessionStorage.getItem(key)) {
          sessionStorage.setItem(key, 'true');
          window.markEggFound?.('case-study-bottom', "You read the whole thing. That's rare. Thank you.");
        }
      }, { passive: true });
    })();
  </script>

  <!-- "What I'd do differently" section tracker -->
  <script>
    (function() {
      if (localStorage.getItem('dd-hard-parts-shown')) return;
      const headings = document.querySelectorAll('h2, h3');
      let targetHeading = null;
      headings.forEach(h => {
        if (h.textContent.toLowerCase().includes("what i'd do differently") ||
            h.textContent.toLowerCase().includes("what i would do differently")) {
          targetHeading = h;
        }
      });
      if (!targetHeading) return;
      const slug = window.location.pathname;
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            let seen = JSON.parse(localStorage.getItem('dd-hard-parts') || '[]');
            if (!seen.includes(slug)) {
              seen.push(slug);
              localStorage.setItem('dd-hard-parts', JSON.stringify(seen));
            }
            if (seen.length >= 2 && !localStorage.getItem('dd-hard-parts-shown')) {
              localStorage.setItem('dd-hard-parts-shown', 'true');
              window.markEggFound?.('hard-parts-twice', "You read the hard part twice. That's a good sign in a PM.");
            }
            observer.disconnect();
          }
        });
      }, { threshold: 0.5 });
      observer.observe(targetHeading);
    })();
  </script>

  <!-- Section number reading indicator -->
  <style is:global>
    .section-num {
      opacity: 0.15;
    }

    @media (prefers-reduced-motion: no-preference) {
      .section-num {
        transition: opacity 400ms ease;
      }
    }

    .section-num.section-active {
      opacity: 1;
    }
  </style>

  <script>
    (function () {
      // Find h2 headings whose text starts with a two-digit number prefix (01–99)
      const headings = document.querySelectorAll<HTMLHeadingElement>('.prose h2');
      const numSpans: Element[] = [];

      headings.forEach((h2) => {
        const text = h2.textContent ?? '';
        if (!/^\d{2}\s/.test(text)) return;

        // Wrap just the number prefix in a styled span
        h2.innerHTML = h2.innerHTML.replace(
          /^(\d{2})/,
          '<span class="section-num">$1</span>'
        );

        const span = h2.querySelector('.section-num');
        if (span) numSpans.push(span);
      });

      if (numSpans.length === 0) return;

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            entry.target.classList.toggle('section-active', entry.isIntersecting);
          });
        },
        {
          rootMargin: '-40% 0px -40% 0px',
          threshold: 0,
        }
      );

      numSpans.forEach((span) => observer.observe(span));
    })();
  </script>

  <span slot="endnav"></span>

  <!-- "What I'd do differently" heading tooltip -->
  <script>
    (function() {
      const headings = document.querySelectorAll('h2, h3');
      headings.forEach(h => {
        if (h.textContent.toLowerCase().includes("what i'd do differently")) {
          h.style.position = 'relative';
          h.style.cursor = 'help';
          const tip = document.createElement('span');
          tip.innerText = 'This section took the longest to write.';
          tip.style.cssText = `
            display: none;
            position: absolute;
            bottom: calc(100% + 8px);
            left: 0;
            background: #1A1A1A;
            color: #F9F7F4;
            font-size: 13px;
            font-family: 'Inter', sans-serif;
            font-weight: 400;
            white-space: nowrap;
            padding: 6px 12px;
            border-radius: 4px;
            pointer-events: none;
            z-index: 100;
          `;
          h.appendChild(tip);
          h.addEventListener('mouseenter', () => { tip.style.display = 'block'; window.markEggFound?.('difficulty-tooltip'); });
          h.addEventListener('mouseleave', () => tip.style.display = 'none');
        }
      });
    })();
  </script>
</Prose>
