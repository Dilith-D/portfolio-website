---
import Base from './Base.astro';
import ReadingProgress from '../components/ReadingProgress.astro';

interface Props {
  title: string;
  description: string;
  date?: string;
  readTime?: string;
  role?: string;
  summary?: string;
  tags?: string[];
  ogImage?: string;
  backHref?: string;
  backLabel?: string;
}

// In Astro 5, MDX layout frontmatter may be nested under .frontmatter
const fm: Record<string, any> = (Astro.props as any).frontmatter ?? Astro.props;
const title: string = fm.title;
const description: string = fm.description;
const date: string | undefined = fm.date;
const readTime: string | undefined = fm.readTime;
const role: string | undefined = fm.role;
const summary: string | undefined = fm.summary;
const tags: string[] = fm.tags ?? [];
const ogImage: string | undefined = fm.ogImage ?? (Astro.props as any).ogImage;
const backHref: string = (Astro.props as any).backHref ?? '/writing';
const backLabel: string = (Astro.props as any).backLabel ?? 'Back to writing';

const meta = [date, readTime, role].filter(Boolean).join(' · ');
---

<Base title={title} description={description || summary || ''} ogImage={ogImage}>
  <ReadingProgress />

  <article class="pt-32 pb-20 px-6">
    <div class="max-w-[740px] mx-auto">

      <a
        href={backHref}
        class="font-body text-sm text-secondary hover:text-primary transition-colors duration-150 inline-block mb-8 no-underline"
        style="text-decoration: none;"
      >← {backLabel}</a>

      {tags.length > 0 && (
        <p class="font-body text-xs tracking-widest uppercase text-secondary mb-3">
          {tags.join('  ·  ')}
        </p>
      )}

      <h1 class="font-display text-5xl md:text-[48px] font-semibold text-primary leading-tight">
        {title}
      </h1>

      {summary && (
        <p class="font-prose text-xl italic text-secondary mt-4">
          {summary}
        </p>
      )}

      {meta && (
        <p class="font-body text-sm text-secondary mt-4">
          {meta}
        </p>
      )}

      <hr class="border-t border-border mt-8 mb-12" />

      <div class="prose">
        <slot />
      </div>

    </div>
  </article>

  <slot name="endnav">
    <div class="max-w-[740px] mx-auto px-6 pb-20">
      <a href="/writing" class="font-body text-sm text-secondary hover:text-primary transition-colors duration-150">← All writing</a>
    </div>
  </slot>

  <!-- Easter Egg: Fast reader — set flag on exit, Base shows toast on next page -->
  <script define:vars={{ hasReadTime: !!readTime }}>
    (function() {
      if (!hasReadTime) return;

      const slug = window.location.pathname;
      const seenKey = 'fast-read-' + slug;
      if (sessionStorage.getItem(seenKey)) return;

      const arrival = Date.now();
      const MIN_TIME = 60 * 1000;

      function maybeFlag() {
        if (sessionStorage.getItem(seenKey)) return;
        const elapsed = Date.now() - arrival;
        if (elapsed < MIN_TIME) {
          sessionStorage.setItem(seenKey, 'true');
          sessionStorage.setItem('fast-read-pending', 'true');
        }
      }

      document.addEventListener('visibilitychange', () => {
        if (document.visibilityState === 'hidden') maybeFlag();
      });
      window.addEventListener('beforeunload', maybeFlag);
    })();
  </script>
</Base>
