---
import Base from '../layouts/Base.astro';
---

<Base
  title="404 — Dilith Dinesh"
  description="Page not found."
>
  <div class="min-h-screen flex flex-col items-center justify-center px-6 text-center">
    <p class="font-display text-[160px] font-semibold leading-none" style="color: #E5E1DB;">
      404
    </p>
    <p class="font-display text-2xl text-primary mt-4">
      Page not found
    </p>
    <a
      href="/"
      class="font-body text-base text-primary underline underline-offset-[3px] mt-8 transition-colors duration-150 hover:text-blue"
    >
      ← Back home
    </a>

    <p id="riddle-q" style="margin-top:32px; font-family:'Inter',sans-serif; font-size:14px; color:#6B6B6B; cursor:pointer;">
      Or: what has inputs, outputs, and gets ignored until it breaks? <span style="opacity:0.5;">(click to reveal)</span>
    </p>
    <p id="riddle-answer" style="margin-top:8px; font-family:'Inter',sans-serif; font-size:14px; color:#6B6B6B; opacity:0; transition:opacity 300ms ease;">
      A system. Also, most PRDs.
    </p>
  </div>

  <script>
    document.getElementById('riddle-q').addEventListener('click', () => {
      document.getElementById('riddle-answer').style.opacity = '1';
      window.markEggFound?.('404-riddle');
    });
  </script>
</Base>
