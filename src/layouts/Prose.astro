---
import Base from './Base.astro';
import ReadingProgress from '../components/ReadingProgress.astro';

interface Props {
  title: string;
  description: string;
  date?: string;
  readTime?: string;
  role?: string;
  summary?: string;
  tags?: string[];
  ogImage?: string;
}

const { title, description, date, readTime, role, summary, tags = [], ogImage } = Astro.props;

const meta = [date, readTime, role].filter(Boolean).join(' · ');
---

<Base title={title} description={description} ogImage={ogImage}>
  <ReadingProgress />

  <slot name="backnav">
    <div class="max-w-[740px] mx-auto px-6 pt-6"><a href="/writing" class="font-body text-sm text-secondary hover:text-primary transition-colors duration-150">← Back to writing</a></div>
  </slot>

  <article class="pt-24 pb-20 px-6">
    <div class="max-w-[740px] mx-auto">

      {tags.length > 0 && (
        <p class="font-body text-xs tracking-widest uppercase text-secondary mb-3">
          {tags.join('  ·  ')}
        </p>
      )}

      <h1 class="font-display text-5xl md:text-[48px] font-semibold text-primary leading-tight">
        {title}
      </h1>

      {summary && (
        <p class="font-prose text-xl italic text-secondary mt-4">
          {summary}
        </p>
      )}

      {meta && (
        <p class="font-body text-sm text-secondary mt-4">
          {meta}
        </p>
      )}

      <hr class="border-t border-border mt-8 mb-12" />

      <div class="prose">
        <slot />
      </div>

    </div>
  </article>
</Base>
