---
---
<div class="diagram-wrap">
  <p class="diagram-label">Spotify Wrapped — 5-Act Narrative Arc</p>

  <div class="arc-list">
    <div class="arc-step">
      <div class="step-left">
        <div class="step-dot dot-dark"></div>
        <div class="step-line"></div>
      </div>
      <div class="step-card step-card-dark">
        <div class="act-label">Act I</div>
        <div class="act-name">The Hook</div>
        <div class="act-desc">Your year in music starts.</div>
      </div>
    </div>

    <div class="arc-step">
      <div class="step-left">
        <div class="step-dot"></div>
        <div class="step-line"></div>
      </div>
      <div class="step-card">
        <div class="act-label">Act II</div>
        <div class="act-name">The Build</div>
        <div class="act-desc">Your #1 artist revealed. Time spent. Ranking vs. other listeners.</div>
      </div>
    </div>

    <div class="arc-step">
      <div class="step-left">
        <div class="step-dot"></div>
        <div class="step-line"></div>
      </div>
      <div class="step-card">
        <div class="act-label">Act III</div>
        <div class="act-name">The Climax</div>
        <div class="act-desc">Your top songs — curated into a playlist you keep.</div>
      </div>
    </div>

    <div class="arc-step">
      <div class="step-left">
        <div class="step-dot"></div>
        <div class="step-line"></div>
      </div>
      <div class="step-card">
        <div class="act-label">Act IV</div>
        <div class="act-name">The Identity Moment</div>
        <div class="act-desc">You're a specific listening personality type.</div>
      </div>
    </div>

    <div class="arc-step arc-step-last">
      <div class="step-left">
        <div class="step-dot dot-blue"></div>
      </div>
      <div class="step-card step-card-blue">
        <div class="act-label act-label-blue">Act V</div>
        <div class="act-name act-name-blue">The Flex</div>
        <div class="act-desc">Top X% of this artist's listeners worldwide.</div>
      </div>
    </div>
  </div>
</div>

<style>
  .diagram-wrap {
    background: var(--color-surface);
    border-radius: 8px;
    padding: 32px 28px;
    border-left: 2px solid var(--color-border);
    margin: 2rem 0;
    font-family: 'Inter', sans-serif;
  }
  .diagram-label {
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-secondary);
    margin-bottom: 24px;
  }
  .arc-list {
    display: flex;
    flex-direction: column;
  }
  .arc-step {
    display: flex;
    align-items: flex-start;
    gap: 14px;
  }
  .step-left {
    display: flex;
    flex-direction: column;
    align-items: center;
    flex-shrink: 0;
    padding-top: 12px;
  }
  .step-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    border: 1px solid var(--color-border);
    background: var(--color-background);
    flex-shrink: 0;
  }
  .dot-dark {
    background: var(--color-primary);
    border-color: var(--color-primary);
  }
  .dot-blue {
    background: var(--color-blue);
    border-color: var(--color-blue);
  }
  .step-line {
    width: 1px;
    flex: 1;
    min-height: 16px;
    background: var(--color-border);
    margin-top: 3px;
  }
  .step-card {
    border-radius: 6px;
    border: 1px solid var(--color-border);
    background: var(--color-background);
    padding: 10px 14px;
    margin-bottom: 6px;
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 3px;
  }
  .step-card-dark {
    background: var(--color-primary);
    border-color: var(--color-primary);
  }
  .step-card-blue {
    border-color: var(--color-blue);
  }
  .act-label {
    font-size: 9px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-secondary);
    font-weight: 500;
  }
  .step-card-dark .act-label { color: rgba(249, 247, 244, 0.5); }
  .act-label-blue { color: var(--color-blue) !important; }

  .act-name {
    font-size: 12px;
    font-weight: 600;
    color: var(--color-primary);
    line-height: 1.3;
  }
  .step-card-dark .act-name { color: #F9F7F4; }
  .act-name-blue { color: var(--color-blue); }

  .act-desc {
    font-size: 10px;
    color: var(--color-secondary);
    line-height: 1.4;
  }
  .step-card-dark .act-desc { color: rgba(249, 247, 244, 0.6); }
</style>
