---
import Base from '../layouts/Base.astro';
---

<Base
  title="Contact — Dilith Dinesh"
  description="Open to APM and product roles at Series A/B product-led companies."
>
  <div class="max-w-[740px] mx-auto px-6 pt-[120px] pb-[80px]">

    <h1 class="font-display text-[48px] font-medium leading-tight text-primary">Contact</h1>

    <p class="font-body text-lg text-primary leading-relaxed mt-6">
      If you're building something that needs<br />
      this kind of thinking — I want to hear<br />
      about it.
    </p>

    <hr class="border-t border-border my-[80px]" />

    <!-- I'm currently open to -->
    <section class="mb-[80px]">
      <h2 class="font-display text-[32px] font-medium leading-snug text-primary mb-6">I'm currently open to</h2>

      <div class="flex flex-col gap-4">
        <p class="font-body text-base text-primary leading-relaxed">
          APM and product roles at Series A/B<br />
          product-led companies
        </p>
        <p class="font-body text-base text-primary leading-relaxed">
          Conversations about vertical SaaS,<br />
          AI-first product, and field operations
        </p>
        <p class="font-body text-base text-primary leading-relaxed">
          Feedback on my writing — especially<br />
          if you disagree with something
        </p>
      </div>
    </section>

    <hr class="border-t border-border mb-[80px]" />

    <!-- Links -->
    <section class="mb-[80px]">
      <div class="flex flex-col gap-4">
        <span class="email-egg" style="position:relative;">
          <a
            href="mailto:dilithdinesh007@gmail.com"
            class="font-body text-base font-medium text-primary underline underline-offset-[3px] transition-colors duration-150 hover:text-blue"
            style="cursor:help;"
          >
            dilithdinesh007@gmail.com
          </a>
          <span class="email-tip" style="display:none; position:absolute; bottom:calc(100% + 8px); left:50%; transform:translateX(-50%); background:#1A1A1A; color:#F9F7F4; font-size:13px; font-family:'Inter',sans-serif; white-space:normal; max-width:320px; padding:6px 12px; border-radius:4px; pointer-events:none; z-index:100; text-align:center;">I read everything. I reply to most things. Response time: usually within a day, never within a minute — that would be suspicious.</span>
        </span>
        <a
          href="https://linkedin.com/in/dilithdinesh"
          target="_blank"
          rel="noopener noreferrer"
          class="font-body text-base font-medium text-primary underline underline-offset-[3px] transition-colors duration-150 hover:text-blue"
        >
          LinkedIn →
        </a>
      </div>
    </section>

    <hr class="border-t border-border mb-[80px]" />

    <!-- Closing -->
    <p class="font-body text-base text-secondary leading-relaxed">
      I read everything. I reply to most things.
    </p>

  </div>

  <!-- Leave contact page without clicking email -->
  <script>
    (function() {
      if (sessionStorage.getItem('dd-contact-left')) return;
      let emailClicked = false;
      const emailLink = document.querySelector('a[href^="mailto"]');
      if (emailLink) emailLink.addEventListener('click', () => emailClicked = true);
      function maybeShow() {
        if (!emailClicked && !sessionStorage.getItem('dd-contact-left')) {
          sessionStorage.setItem('dd-contact-left', 'true');
          window.markEggFound?.('contact-leave', "Changed your mind? The email stays open. dilithdinesh007@gmail.com");
        }
      }
      document.addEventListener('visibilitychange', () => {
        if (document.visibilityState === 'hidden') maybeShow();
      });
      window.addEventListener('beforeunload', maybeShow);
    })();
  </script>

  <!-- Easter Egg: email tooltip -->
  <script>
    const emailEgg = document.querySelector('.email-egg');
    const emailTip = document.querySelector('.email-tip');
    emailEgg.addEventListener('mouseenter', () => { emailTip.style.display = 'block'; window.markEggFound?.('email-tooltip'); });
    emailEgg.addEventListener('mouseleave', () => emailTip.style.display = 'none');
  </script>
</Base>
