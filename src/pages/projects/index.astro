---
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
---

<Base
  title="Projects · Dilith Dinesh"
  description="Six personal builds by Dilith Dinesh, newest first: Reeve (an Android budgeting app that reads bank SMS on the device), Delphi (tax filing intelligence for foreign founders), SuperPilot (AI CRM memory layer), a live voice agent, Iris (cross-device file transfer), and Winledger, formerly Pulseboard (a private brag sheet for work wins). Build logs documenting the decisions and lessons."
>
  <div class="max-w-[1100px] mx-auto px-6 pt-[120px] pb-[80px]">

    <div class="max-w-[740px] mb-[80px]">
      <h1 class="font-display text-[48px] font-medium leading-tight text-primary">Projects</h1>

      <p class="font-prose text-lg leading-reading text-primary mt-6">
        A PM who can't prototype is a PM who
        can't think in three dimensions.
      </p>

      <p class="font-prose text-lg leading-reading text-primary mt-4">
        These are things I built to solve problems
        I had, and to stay honest about what
        building actually costs.
      </p>

      <p class="font-body text-base text-secondary mt-6">
        Shipping your own problems first is the
        fastest way to develop product judgment
        you can't fake.
      </p>
    </div>

    <!-- Newest first. When adding a project, put it at the top. -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <ProjectCard
        title="Reeve"
        problem="Every Indian bank texts you when money moves, so the inbox is the real ledger. I built the Android budgeting app that reads it on the device, files transactions by rule, and never sends the messages to a server."
        stack={["Kotlin", "Jetpack Compose", "Supabase"]}
        year="2026"
        slug="reeve"
        liveUrl="https://pfos-tracker.vercel.app/login"
      />
      <ProjectCard
        title="Delphi"
        problem="Foreign founders with Delaware C-Corps face a $25,000 penalty for missing Form 5472. Most don't know it exists. I built the tool that tells them exactly what they owe, before they talk to a CPA."
        stack={["Claude API", "Vanilla JS", "Vercel"]}
        year="2026"
        slug="delphi"
        liveUrl="https://delphi-tax.vercel.app"
      />
      <ProjectCard
        title="SuperPilot"
        problem="B2B sales reps lose 2 hours a day across 6 deal handoffs. The data to fix it exists. I built the AI layer that synthesizes it into memory."
        stack={["React", "TanStack", "Claude Sonnet", "Deepgram"]}
        year="2026"
        slug="superpilot"
      />
      <ProjectCard
        title="The Voice Agent"
        problem="A contact form would tell you I'm interested in AI product work. A voice agent shows you how I think about it. So I built one, and documented every decision behind it."
        stack={["VAPI", "Deepgram", "ElevenLabs", "GPT-4o Mini"]}
        year="2026"
        slug="voice-agent"
      />
      <ProjectCard
        title="Iris"
        problem="I needed a messaging app that worked across devices without forcing me into one ecosystem. So I built one."
        stack={["React 18", "TypeScript", "Supabase"]}
        year="2026"
        slug="iris"
        liveUrl="https://d-chat.lovable.app"
      />
      <ProjectCard
        title="Winledger"
        problem="A colleague asked what I'd been working on and I blanked. I built a work log in a weekend, then a year later audited it like a product I had to launch, cut the AI, rebuilt it with Claude Code, and added a phone app to bring people back."
        stack={["React", "Supabase", "Kotlin", "Claude Code"]}
        year="2025 · 2026"
        slug="winledger"
        liveUrl="https://winledger.vercel.app"
      />
    </div>

  </div>
</Base>
