---
---
<div class="diagram-wrap">
  <p class="diagram-label">Booking Widget: Four Modes</p>

  <div class="node-wrap">
    <div class="node node-dark node-lg">
      Contractor configures booking widget
    </div>
  </div>

  <div class="v-line"></div>

  <div class="branch-grid cols-4">
    <div class="b-col">
      <div class="v-drop"></div>
      <div class="mode-card mode-card-blue">
        <div class="mode-num">Mode 1</div>
        <div class="mode-name">Full Booking</div>
        <div class="mode-desc">Customer selects time, inspection created automatically</div>
      </div>
      <div class="mode-who">High-volume, systemized contractors</div>
    </div>
    <div class="b-col">
      <div class="v-drop"></div>
      <div class="mode-card">
        <div class="mode-num">Mode 2</div>
        <div class="mode-name">Lead Intake</div>
        <div class="mode-desc">Customer submits info, team schedules manually</div>
      </div>
      <div class="mode-who">Teams that qualify leads before scheduling</div>
    </div>
    <div class="b-col">
      <div class="v-drop"></div>
      <div class="mode-card">
        <div class="mode-num">Mode 3</div>
        <div class="mode-name">Customer-Only</div>
        <div class="mode-desc">Contact record created, no job or inspection</div>
      </div>
      <div class="mode-who">CRM-first workflows</div>
    </div>
    <div class="b-col">
      <div class="v-drop"></div>
      <div class="mode-card">
        <div class="mode-num">Mode 4</div>
        <div class="mode-name">Job Without Scheduling</div>
        <div class="mode-desc">Job created immediately, no time selection</div>
      </div>
      <div class="mode-who">Emergency / immediate dispatch</div>
    </div>
  </div>

  <div class="v-line"></div>

  <div class="node-wrap">
    <div class="node node-dark node-lg">
      One widget. Contractor picks the mode. Deploys in under 2 minutes.
    </div>
  </div>
</div>

<style>
  .diagram-wrap {
    background: var(--color-surface);
    border-radius: 8px;
    padding: 32px 28px;
    border-left: 2px solid var(--color-border);
    margin: 2rem 0;
    font-family: 'Inter', sans-serif;
  }
  .diagram-label {
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-secondary);
    margin-bottom: 24px;
  }
  .node-wrap {
    display: flex;
    justify-content: center;
  }
  .node-lg { max-width: 420px; width: 100%; }

  .node {
    border-radius: 6px;
    border: 1px solid var(--color-border);
    background: var(--color-background);
    padding: 10px 16px;
    font-size: 13px;
    font-weight: 500;
    color: var(--color-primary);
    text-align: center;
  }
  .node-dark {
    background: var(--color-primary);
    color: #F9F7F4;
    border-color: var(--color-primary);
    padding: 12px 20px;
  }

  .v-line {
    width: 1px;
    height: 20px;
    background: var(--color-border);
    margin: 0 auto;
  }
  .v-drop {
    width: 1px;
    height: 16px;
    background: var(--color-border);
    margin: 0 auto;
  }

  .branch-grid {
    display: grid;
    gap: 8px;
    position: relative;
  }
  .cols-4 { grid-template-columns: 1fr 1fr 1fr 1fr; }

  /* Top fork: horizontal line at midpoint of v-drops */
  .cols-4::before {
    content: '';
    position: absolute;
    height: 1px;
    background: var(--color-border);
    top: 8px;
    left: 12.5%;
    right: 12.5%;
  }

  .b-col {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .mode-card {
    border-radius: 6px;
    border: 1px solid var(--color-border);
    background: var(--color-background);
    padding: 10px 12px;
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 5px;
    flex: 1;
  }
  .mode-card-blue {
    border-color: var(--color-blue);
  }
  .mode-card-blue .mode-num {
    color: var(--color-blue);
  }

  .mode-num {
    font-size: 9px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-secondary);
    font-weight: 500;
  }
  .mode-name {
    font-size: 12px;
    font-weight: 600;
    color: var(--color-primary);
    line-height: 1.3;
  }
  .mode-desc {
    font-size: 10px;
    color: var(--color-secondary);
    line-height: 1.4;
  }
  .mode-who {
    font-size: 9px;
    color: var(--color-secondary);
    text-align: center;
    padding: 6px 2px 0;
    line-height: 1.3;
    font-style: italic;
  }

  @media (max-width: 640px) {
    .branch-grid { grid-template-columns: 1fr 1fr; }
    .cols-4::before { display: none; }
    .v-drop { display: none; }
  }
</style>
