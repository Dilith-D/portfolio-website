---
interface Props {
  title: string;
  hook: string;
  date: string;
  tags: string[];
  slug: string;
}

const { title, hook, date, tags, slug } = Astro.props;
const tagLabel = tags.map(t => t.toUpperCase()).join('  ·  ');
const dateLabel = date.toUpperCase();
---

<a href={`/writing/${slug}`} class="essay-row reveal">
  <div>
    <p class="essay-meta">{dateLabel}&nbsp;&nbsp;·&nbsp;&nbsp;{tagLabel}</p>
    <span class="essay-title">{title}</span>
    <p class="essay-hook">{hook}</p>
  </div>
  <p class="essay-cta">Read →</p>
</a>
