---
<div class="diagram-wrap">
  <p class="diagram-label">Roofing Account — Three Pipelines</p>

  <div class="node-wrap">
    <div class="node node-dark node-lg">
      Contractor signs with Zuper
    </div>
  </div>

  <div class="v-line"></div>

  <div class="branch-grid cols-3">
    <div class="b-col">
      <div class="v-drop"></div>
      <div class="card card-blue">
        <div class="pipe-num">Pipeline 01</div>
        <div class="pipe-name">Lead Qualification</div>
        <div class="pipe-desc">Homeowner contact → site assessment → eligibility check</div>
      </div>
      <div class="v-rise"></div>
    </div>
    <div class="b-col">
      <div class="v-drop"></div>
      <div class="card">
        <div class="pipe-num">Pipeline 02</div>
        <div class="pipe-name">Inspection</div>
        <div class="pipe-desc">On-site visit → damage assessment → proposal</div>
      </div>
      <div class="v-rise"></div>
    </div>
    <div class="b-col">
      <div class="v-drop"></div>
      <div class="card">
        <div class="pipe-num">Pipeline 03</div>
        <div class="pipe-name">Production</div>
        <div class="pipe-desc">Materials ordered → crew assigned → job completed</div>
      </div>
      <div class="v-rise"></div>
    </div>
  </div>

  <div class="v-line"></div>

  <div class="node-wrap">
    <div class="node node-dark node-lg">
      <div>Cloneable golden account</div>
      <div class="node-sub">Pre-configured · roofing terminology · day-zero ready</div>
    </div>
  </div>
</div>

<style>
  .diagram-wrap {
    background: var(--color-surface);
    border-radius: 8px;
    padding: 32px 28px;
    border-left: 2px solid var(--color-border);
    margin: 2rem 0;
    font-family: 'Inter', sans-serif;
  }
  .diagram-label {
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-secondary);
    margin-bottom: 24px;
  }

  /* Node wrapper — centers constrained nodes */
  .node-wrap {
    display: flex;
    justify-content: center;
  }
  .node-lg { max-width: 420px; width: 100%; }

  .node {
    border-radius: 6px;
    border: 1px solid var(--color-border);
    background: var(--color-background);
    padding: 10px 16px;
    font-size: 13px;
    font-weight: 500;
    color: var(--color-primary);
    text-align: center;
  }
  .node-dark {
    background: var(--color-primary);
    color: #F9F7F4;
    border-color: var(--color-primary);
    padding: 12px 20px;
  }
  .node-sub {
    font-size: 10px;
    font-weight: 400;
    color: rgba(249, 247, 244, 0.6);
    margin-top: 3px;
  }

  /* Vertical connector */
  .v-line {
    width: 1px;
    height: 20px;
    background: var(--color-border);
    margin: 0 auto;
  }
  /* Short drops inside columns */
  .v-drop, .v-rise {
    width: 1px;
    height: 16px;
    background: var(--color-border);
    margin: 0 auto;
  }

  /* Branch grid with fork connectors via pseudo-elements */
  .branch-grid {
    display: grid;
    gap: 10px;
    position: relative;
  }
  .cols-3 { grid-template-columns: 1fr 1fr 1fr; }

  /* Top horizontal line — connects column centers at midpoint of v-drop */
  .cols-3::before {
    content: '';
    position: absolute;
    height: 1px;
    background: var(--color-border);
    top: 8px;
    left: calc(100% / 6);
    right: calc(100% / 6);
  }
  /* Bottom horizontal line — merge connector at midpoint of v-rise */
  .cols-3::after {
    content: '';
    position: absolute;
    height: 1px;
    background: var(--color-border);
    bottom: 8px;
    left: calc(100% / 6);
    right: calc(100% / 6);
  }

  .b-col {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  /* Pipeline cards fill their column */
  .card {
    border-radius: 6px;
    border: 1px solid var(--color-border);
    background: var(--color-background);
    padding: 10px 14px;
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 5px;
    flex: 1;
  }
  .card-blue {
    border-color: var(--color-blue);
  }
  .card-blue .pipe-num {
    color: var(--color-blue);
  }

  .pipe-num {
    font-size: 9px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-secondary);
    font-weight: 500;
  }
  .pipe-name {
    font-size: 12px;
    font-weight: 600;
    color: var(--color-primary);
    line-height: 1.3;
  }
  .pipe-desc {
    font-size: 10px;
    color: var(--color-secondary);
    line-height: 1.4;
  }

  @media (max-width: 640px) {
    .branch-grid { grid-template-columns: 1fr; }
    .cols-3::before, .cols-3::after { display: none; }
    .v-drop, .v-rise { display: none; }
  }
</style>
