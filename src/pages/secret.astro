---
import Base from '../layouts/Base.astro';
import easterEggs from '../data/easter-eggs.json';
---

<Base
  title="Secret — Dilith Dinesh"
  description="You found it. Now find the rest."
>
  <div class="max-w-[740px] mx-auto px-6 pt-[120px] pb-[80px]">

    <p class="font-body text-xs tracking-widest uppercase text-secondary mb-3">
      You found it
    </p>

    <h1 class="font-display text-[48px] font-medium leading-tight text-primary">
      Hidden things
    </h1>

    <p class="font-body text-base text-secondary mt-4 leading-relaxed">
      This site has <span id="total-count">{easterEggs.length}</span> easter eggs.
      You've found <span id="found-count">0</span>.
    </p>

    <div class="mt-4 h-[2px] bg-surface rounded-full overflow-hidden">
      <div
        id="progress-bar"
        style="width:0%; height:100%; background:#2D5BE3; transition:width 600ms ease;"
      ></div>
    </div>

    <hr class="border-t border-border my-12" />

    <div>
      {easterEggs.map((egg) => (
        <div
          class="egg-item flex items-start gap-4 py-4 border-b border-border"
          data-id={egg.id}
        >
          <span
            class="egg-status flex-shrink-0 w-2 h-2 rounded-full bg-border"
            style="margin-top:7px;"
          ></span>
          <p class="egg-message font-body text-sm text-secondary leading-relaxed">
            {egg.hint}
          </p>
        </div>
      ))}
    </div>

    <p class="font-body text-sm text-secondary mt-12 leading-relaxed">
      Some require specific timing. A few require returning.<br />
      One requires patience you probably don't have.<br />
      The console eggs can't be tracked — but they're there.
    </p>

  </div>

  <script>
    fetch('/easter-eggs.json')
      .then(r => r.json())
      .then(eggs => {
        const total = eggs.length;
        const found = JSON.parse(localStorage.getItem('dd-found-eggs') || '[]');
        const foundCount = found.filter((id: string) => eggs.find((e: {id: string}) => e.id === id)).length;

        document.getElementById('total-count')!.textContent = String(total);
        document.getElementById('found-count')!.textContent = String(foundCount);
        (document.getElementById('progress-bar') as HTMLElement).style.width = ((foundCount / total) * 100) + '%';

        document.querySelectorAll('.egg-item').forEach(item => {
          const id = (item as HTMLElement).dataset.id;
          const egg = eggs.find((e: {id: string}) => e.id === id);
          const dot = item.querySelector('.egg-status') as HTMLElement;
          const message = item.querySelector('.egg-message') as HTMLElement;

          if (id && found.includes(id) && egg) {
            dot.style.background = '#2D5BE3';
            message.textContent = '\u201C' + egg.message + '\u201D';
            message.style.color = '#6B6B6B';
            message.style.fontStyle = 'italic';
          }
        });
      });
  </script>
</Base>
