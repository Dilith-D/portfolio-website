---
---
<div class="diagram-wrap">
  <p class="diagram-label">Iris — Architecture</p>

  <!-- Top: Device A + Device B with fork connector -->
  <div class="devices-row">
    <div class="device-col">
      <div class="input-label">Input</div>
      <div class="node node-light">Device A</div>
    </div>
    <div class="device-col">
      <div class="input-label">Input</div>
      <div class="node node-light">Device B / Trusted contact</div>
    </div>
  </div>

  <!-- Fork connector: horizontal line + vertical drop from midpoint -->
  <div class="fork-connector">
    <div class="fork-h-line"></div>
    <div class="fork-v-line"></div>
  </div>

  <!-- Pairing code -->
  <div class="center-node-wrap">
    <div class="node node-blue pairing-node">
      <div class="node-name">8-character pairing code</div>
      <div class="node-sub-light">Share the code. Enter it. Connected.</div>
    </div>
  </div>

  <div class="v-line"></div>

  <!-- Supabase -->
  <div class="center-node-wrap">
    <div class="node node-dark supabase-node">
      <div class="node-name">Supabase backend</div>
      <div class="tag-row">
        <span class="tag">Per-tenant isolation</span>
        <span class="tag">Encrypted API keys</span>
        <span class="tag">Signed URLs</span>
      </div>
    </div>
  </div>

  <!-- Reverse fork: vertical line splits to two bottom nodes -->
  <div class="split-connector">
    <div class="split-v-line"></div>
    <div class="split-h-line"></div>
  </div>

  <!-- Bottom two nodes -->
  <div class="devices-row">
    <div class="device-col">
      <div class="node node-light">React 18 + TypeScript</div>
    </div>
    <div class="device-col">
      <div class="node node-light">Persistent sessions</div>
    </div>
  </div>

  <p class="bottom-note">
    No accounts. No installs required. Register a device, share a code, start sending.
  </p>
</div>

<style>
  .diagram-wrap {
    background: var(--color-surface);
    border-radius: 8px;
    padding: 32px 28px;
    border-left: 2px solid var(--color-border);
    margin: 2rem 0;
    font-family: 'Inter', sans-serif;
  }

  .diagram-label {
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-secondary);
    margin-bottom: 24px;
  }

  /* ── Nodes ── */
  .node {
    border-radius: 6px;
    border: 1px solid var(--color-border);
    background: var(--color-background);
    padding: 10px 16px;
    font-size: 12px;
    font-weight: 500;
    color: var(--color-primary);
    text-align: center;
  }

  .node-light {
    background: var(--color-background);
  }

  .node-dark {
    background: var(--color-primary);
    color: #F9F7F4;
    border-color: var(--color-primary);
  }

  .node-blue {
    border-color: var(--color-blue);
  }

  .pairing-node {
    max-width: 340px;
    width: 100%;
  }

  .supabase-node {
    max-width: 400px;
    width: 100%;
  }

  .node-name {
    font-size: 12px;
    font-weight: 500;
  }

  .node-sub-light {
    font-size: 10px;
    font-weight: 400;
    color: var(--color-secondary);
    margin-top: 3px;
  }

  /* ── Tag pills inside Supabase node ── */
  .tag-row {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    justify-content: center;
    margin-top: 8px;
  }

  .tag {
    background: var(--color-background);
    border: 1px solid var(--color-border);
    border-radius: 4px;
    padding: 2px 8px;
    font-size: 9px;
    font-weight: 400;
    color: #1A1A1A;
    display: inline-flex;
    align-items: center;
  }

  /* ── Device rows ── */
  .devices-row {
    display: flex;
    justify-content: center;
    gap: 40px;
  }

  .device-col {
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: 200px;
    width: 100%;
  }

  .input-label {
    font-size: 9px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-secondary);
    margin-bottom: 6px;
  }

  /* ── Center node wrapper ── */
  .center-node-wrap {
    display: flex;
    justify-content: center;
  }

  /* ── Vertical line ── */
  .v-line {
    width: 1px;
    height: 20px;
    background: var(--color-border);
    margin: 0 auto;
  }

  /* ── Fork connector (two devices → one pairing code) ── */
  .fork-connector {
    display: flex;
    flex-direction: column;
    align-items: center;
    height: 28px;
    position: relative;
  }

  /* Horizontal line spanning between the two device column centers.
     The devices-row has gap:40px and each col is max 200px.
     We approximate the span with a fixed width. */
  .fork-h-line {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 240px;
    height: 1px;
    background: var(--color-border);
  }

  /* Vertical drop from midpoint of horizontal line down to pairing node */
  .fork-v-line {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 1px;
    height: 100%;
    background: var(--color-border);
  }

  /* ── Split connector (Supabase → two bottom nodes) ── */
  .split-connector {
    display: flex;
    flex-direction: column;
    align-items: center;
    height: 28px;
    position: relative;
  }

  .split-v-line {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 1px;
    height: 100%;
    background: var(--color-border);
  }

  .split-h-line {
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 240px;
    height: 1px;
    background: var(--color-border);
  }

  /* ── Bottom note ── */
  .bottom-note {
    margin-top: 20px;
    font-size: 11px;
    font-style: italic;
    color: var(--color-secondary);
    text-align: center;
    line-height: 1.5;
    padding-top: 16px;
    border-top: 1px solid var(--color-border);
  }

  /* ── Mobile ── */
  @media (max-width: 640px) {
    .devices-row {
      flex-direction: column;
      align-items: center;
      gap: 8px;
    }

    .fork-h-line,
    .split-h-line {
      display: none;
    }

    .fork-connector,
    .split-connector {
      height: 20px;
    }
  }
</style>
