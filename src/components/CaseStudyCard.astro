---
interface Props {
  title: string;
  tags: string[];
  description: string;
  slug: string;
  featured?: boolean;
  stagger?: number;
}

const { title, tags, description, slug, featured = false, stagger = 0 } = Astro.props;
---

<div
  class:list={['reveal', { 'card-featured-wrap': featured }]}
  style={`transition-delay: calc(${stagger} * 90ms)`}
>
  <a
    href={`/work/${slug}`}
    class:list={['card-wrap', { 'card-featured': featured }]}
  >
    <span class="edge-light" aria-hidden="true"></span>
    <div class="card-body">
      <p class="card-tags">{tags.join('  ·  ')}</p>
      <h3 class="card-title">{title}</h3>
      <p class="card-desc">{description}</p>
      <span class="card-link">
        Read the case study
        <span aria-hidden="true">→</span>
      </span>
    </div>
  </a>
</div>
